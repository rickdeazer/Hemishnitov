#endItems {
  display: flex;
  min-width: 40%;
  align-items: start;
  border-left: solid 4px rgba(251, 251, 251, 0.062);
  border-radius: 7px;
  background: linear-gradient(90deg, black, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0));
}
.normalScroll {
  overflow-x: auto;
  scroll-behavior: smooth;
  color: deepskyblue;
}
/* .app {
  background: linear-gradient(rgb(37, 4, 43),green,black,red,cyan);} */
#viewers {
  display: flex;
  flex-direction: column;
  width: 50%;
  align-items: start;
  padding-left: 3px;
  border-radius: 5%;
  gap: 6px;
  height: stretch;
  border-left: solid 2px rgb(6, 170, 9);
}
#popUp {
  background: linear-gradient(170deg,green,transparent,transparent,rgba(156, 2, 2, 0.596));
  border: solid 2px white;
  padding: 5px;
  border-radius: 10px;
  font-family: 'calibri';
  font-size: large;
  text-align: center;
  z-index: 100;
  display: none;
  position: fixed;
  top: 20%;
  width: 60%;
  animation: backG 3s ease infinite;
  transition: all 3s ease;
}
@keyframes backG {
  0%{}  
  30%{background-color: rgb(106, 6, 6);}
  60%{background-color: rgb(6, 93, 6);}
  100%{background-color: transparent;}
}
#views {
  font-size: 13px;
  color: rgb(17, 149, 4);
  text-align: start;
  display: flex;
  font-family: Cambria, Cochin, Georgia, Times, "Times New Roman", serif;
  font-style: italic;
  flex-direction: column;
}
#viewersCount {
