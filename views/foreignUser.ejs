<script>
const showTonnerDiv = document.getElementById("showTonner");
const Handle = document.getElementById("Handle");
const img = document.querySelector(".profile-photo");
const imgDiv = document.querySelector(".editable-photo");
const followBtn = document.getElementById("followBtn");
const interestBtn = document.getElementById("intestBtn");
const blogTitle = document.querySelector(".blogTitle");
let username = document.getElementById("profName")
let foreignUserClicked = profName.innerText;
let mainUser = JSON.parse(localStorage.getItem("mainUser"));
let isFollowing = false;
let followersCount = document.getElementById("followersCount");
let viewersCount = document.getElementById("viewersCount");
let state = "false";
const audioClick = document.getElementById('click');
const audioUnClick = document.getElementById('unClick');
function showTonner(value){
  if(value.slice(0,2) =="no"){
    showTonnerDiv.innerHTML = value;
    showTonnerDiv.style.display = 'flex';
  } else {
    Handle.innerText = value;
    showTonnerDiv.style.display = 'flex';
  }
  setTimeout(() => {
    showTonnerDiv.style.display = "none";
  }, 1000);
}
function shareProfile(user) {
  const profileUrl = `https://moispace.onrender.com/modern/${user}`;
  const shareTitle = "Modern Minds Unifying Network";
  const shareText = "This is a modern profile for a user on MMUN";

  // 🚀 1. Priority: MMUN Android App Native Bridge
  if (window.AndroidInterface && window.AndroidInterface.shareContent) {
    // We pass the URL as the text so it's clickable in messages
    window.AndroidInterface.shareContent(shareTitle, profileUrl);
    return; 
  }

  // 🌐 2. Fallback: Browser Web Share API (Standard Browsers)
  if (navigator.share) {
    navigator.share({
      title: shareTitle,
      text: shareText,
      url: profileUrl
    }).catch((err) => {
      if (err.name !== "AbortError") {
        console.warn("Web Share failed:", err);
      }
    });
  } 
  // 📋 3. Final Fallback: Manual Copy (Optional)
  else {
    if (typeof fallbackCopyLink === 'function') {
        fallbackCopyLink(profileUrl);
    }
  }
}
function blogChanger (){
  blogTitle.innerHTML = `<span class="normalScroll"><%= user.blogTitle || "UNSET TITLE" %></span>`;
};
const marquee = document.querySelector("marquee")
setTimeout(() => {
  blogChanger()
}, marquee.scrollWidth * 14);
let closer = ()=>{
  [img.className, imgDiv.className] = img.classList.contains('clickedPhoto') 
          ? ['profile-photo', 'editable-photo'] 
          : ['clickedPhoto', ''];
}
      img.addEventListener('click', () => {
        if (state == "true"){
          state = "neutral";
          img.style.transform = "rotateY(-180deg)"
        }else if(state == "false"){
          state = "true";
          closer()
        } else{
          state = "false";
          closer()
          setTimeout(() => {
            img.style.transform = "rotateY(0)"
          }, 500);
        }
      }); 

let interestState = false;
let interestValue = '';
async function getStatus() {
  const res = await fetch("/getStatus", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      mainUser: mainUser,
      foreignUser: foreignUserClicked,
    }),
  });
  const data = await res.json();
  interestState = data.state;
  interestValue = data.valueState;
}

  const popUp = document.getElementById('popUp');
  const checker = ()=>{
    if(interestValue == 'interested'){
      updateInterest('Message','black','linear-gradient(60deg,green,yellow)')
    } else if(interestValue == 'pending'){
      updateInterest('Pending','white','linear-gradient(60deg,red,darkBlue)')
    } else if(interestValue == 'declined') {
      updateInterest('Declined!','white','linear-gradient(60deg, black,red)',true)
    }
  };
interestBtn.addEventListener("click", async (interestValue) => {
  if (interestState) {
    if(interestBtn.innerText == 'Pending'){
      popUp.style.display = 'block';
      setTimeout(() => {
      popUp.style.display = 'none';
    }, 2500);
    checker();
    } else if(interestBtn.innerText == 'Message'){
      localStorage.setItem(
          "chatInfo2",
          JSON.stringify({ username: `<%=user.username%>`, profileLink: `<%=user.profileLink%>`, slogan: `<%=user.slogan%>` }),
        );
        window.location.href = "/chatspage";
    }
    return;
  }
  interestState = true;
  interestValue = 'pending';
  updateInterest('Pending','white','linear-gradient(60deg, red,darkBlue)',true);

  try {
    const foreignUser = foreignUserClicked.trim();
    await fetch("/sendInterest", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        mainUser: mainUser,
        foreignUser: foreignUser,
      }),
    });
  } catch (error) {
    console.error("Failed to send interest:", error);
    interestState = false;
    updateInterest('Interest','white','red',false);
  }
});

function updateInterest(value = 'Interest', color = '', background = '', enBoolean = false) {
    interestBtn.style.background = background;
    interestBtn.style.color = color;
    interestBtn.innerHTML = value;
    interestBtn.disabled = enBoolean;
}

(async () => {
  await getStatus();
  checker()
})();

function exit(){
  let editBeacon = localStorage.getItem('editAuthBeacon') || null;
  if(editBeacon){
    window.location.href = "/home";
    localStorage.removeItem("editAuthBeacon");
  } else {
    window.history.back()
  }
  
}
async function getFollowStatus() {
  const res = await fetch("/getFollowStatus", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      from: mainUser,
      to: foreignUserClicked,
    }),
  });

  const data = await res.json();
  isFollowing = data.isFollowing;
  updateFollowButton();
}

function updateFollowButton() {
  if (isFollowing) {
    followBtn.style.background = "linear-gradient(60deg,black,purple)";
    followBtn.style.color = "white";
    followBtn.innerText = "Undisciple";
  } else {
    followBtn.style.background = "";
    followBtn.style.color = "";
    followBtn.innerText = "Disciple";
  }
}

followBtn.addEventListener("click", async () => {
  isFollowing = !isFollowing;
  updateFollowButton();

  const res = await fetch("/toggleFollow", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      from: mainUser,
      to: foreignUserClicked,
    }),
  });
  const data = await res.json();
  followersCount.innerHTML = `<br>${data.followersCount}`;
});

(async () => {
  await getFollowStatus();
})();

async function incrementView() {
  const res = await fetch("/viewProfile", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      viewedUser: foreignUserClicked,
      whoViewed: mainUser,
    }),
  });

  const data = await res.json();
  viewersCount.innerText = data.viewsCount;
}
incrementView();

async function getFollowStatus() {
  const res = await fetch("/getFollowStatus", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      from: mainUser,
      to: foreignUserClicked,
    }),
  });

  const data = await res.json();
  isFollowing = data.isFollowing;
  updateFollowButton();
  followersCount.innerHTML = `<br> ${data.followersCount}`;
}


// 1. Required DOM references
const postsContainer = document.querySelector(".POSTS-CONTENT");
const postsSection   = document.getElementById("postsSection");

// 2. Simple timeAgo function (you need this)
function timeAgo(date) {
  const now = new Date();
  const past = new Date(date);
  const diff = now - past;

  const seconds = Math.floor(diff / 1000);
  const minutes = Math.floor(seconds / 60);
  const hours   = Math.floor(minutes / 60);
  const days    = Math.floor(hours / 24);
  const weeks   = Math.floor(days / 7);

  if (seconds < 60) return "just now";
  if (minutes < 60) return `${minutes}m ago`;
  if (hours   < 24) return `${hours}h ago`;
  if (days    < 7)  return `${days}d ago`;
  if (weeks   < 5)  return `${weeks}w ago`;
  return `${Math.floor(days / 30)}m ago`;
}

