  <script src="/dist/androidHeader.js"></script>
  <script>
    function showTab(sectionId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(sectionId).classList.remove('hidden');

      document.querySelectorAll('.tab').forEach(t => t.classList.remove('tab-active'));
      event.target.classList.add('tab-active');
    }

    function toggleSubTab(subId) {
      document.querySelectorAll('.sub-section').forEach(el => el.classList.add('hidden'));
      document.getElementById(subId).classList.remove('hidden');

      document.querySelectorAll('.sub-tab').forEach(btn => btn.classList.remove('sub-tab-active'));
      if (subId === 'sub-jobs') document.getElementById('subtab-jobs').classList.add('sub-tab-active');
      if (subId === 'sub-items') document.getElementById('subtab-items').classList.add('sub-tab-active');
    }

    document.getElementById('theme-toggle').addEventListener('click', () => {
      document.documentElement.classList.toggle('light-mode');
      const icon = document.getElementById('theme-icon');
      icon.textContent = document.documentElement.classList.contains('light-mode') 
        ? 'light_mode' 
        : 'dark_mode';
    });

    // Popup functions
    function showChoicePopup() {
      document.getElementById('choicePopup').style.display = 'flex';
      setTimeout(() => {
        if (document.getElementById('choicePopup').style.display === 'flex') {
          document.getElementById('choicePopup').style.display = 'none';
        }
      }, 5000);
    }

    function showJobForm() {
      document.getElementById('choicePopup').style.display = 'none';
      document.getElementById('jobFormPopup').style.display = 'flex';
    }

    function showItemForm() {
      document.getElementById('choicePopup').style.display = 'none';
      document.getElementById('itemFormPopup').style.display = 'flex';
    }

    function closePopups() {
      document.getElementById('choicePopup').style.display = 'none';
      document.getElementById('jobFormPopup').style.display = 'none';
      document.getElementById('itemFormPopup').style.display = 'none';
    }

    document.getElementById('fab').addEventListener('click', showChoicePopup);

    document.getElementById('jobForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Job posted successfully!');
      closePopups();
    });

    document.getElementById('itemForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Item posted successfully!');
      closePopups();
    });

    [document.getElementById('choicePopup'), document.getElementById('jobFormPopup'), document.getElementById('itemFormPopup')].forEach(popup => {
      popup.addEventListener('click', (e) => {
        if (e.target === popup) closePopups();
      });
    });

    document.querySelector('.tab').click();
    toggleSubTab('sub-jobs');
    function sendfeedback(vote,page) {
        fetch('/feedback/page/vote', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ voteData: {vote: vote, page: page} })
        }).then(res=>res.json()).then((data)=>{
          const box = document.querySelector('#x');
          console.log(box);
          box.innerHTML = data.response
        })}
  </script>

