<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Policy – MMUN | Modern Minds Unifying Network</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy: #0D1F3C;
      --blue: #1A3C6E;
      --accent: #2E75B6;
      --accent-light: #5BA3D9;
      --gold: #C9A84C;
      --bg: #F7F8FA;
      --surface: #FFFFFF;
      --text: #1C2B3A;
      --muted: #5A6A7A;
      --border: #DDE4EC;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      font-size: 16px;
    }

    /* ── HEADER ── */
    header {
      background: var(--navy);
      padding: 56px 24px 48px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 80% at 20% 50%, rgba(46,117,182,0.25) 0%, transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 30%, rgba(201,168,76,0.12) 0%, transparent 70%);
      pointer-events: none;
    }

    .header-inner { position: relative; z-index: 1; max-width: 680px; margin: 0 auto; }

    #backBtn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: red;
      border: 1px solid rgba(197, 35, 35, 0.25);
      color: rgba(255,255,255,0.7);
      font-size: 0.82rem;
      padding: 6px 16px;
      border-radius: 100px;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      transition: all 0.2s;
      align-self: center;
      text-decoration: none;
    }
    #backBtn:hover { background: rgba(232, 14, 14, 0.1); color: #fff; }

    #logoImg {
      width: 70px; height: 70px;
      margin-left: 10px;
      display: inline-flex;
      align-self: center;
      border-radius: 40%;
      box-shadow: 0 0 10px rgb(54,183,114);
      object-fit: contain;
      margin-right: 8px;
    }

    .app-name {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      color: white;
      letter-spacing: -0.5px;
      line-height: 1.1;
    }

    .app-subtitle {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.55);
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-top: 6px;
      font-weight: 300;
    }

    .policy-badge {
      display: inline-block;
      background: rgba(201,168,76,0.15);
      border: 1px solid rgba(201,168,76,0.4);
      color: var(--gold);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 6px 18px;
      border-radius: 100px;
      margin: 24px 0 16px;
    }

    .effective-date {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.45);
    }

    /* ── LAYOUT ── */
    .wrapper {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    /* ── TOC ── */
    .toc {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 36px;
      margin: 48px 0 40px;
      box-shadow: 0 2px 16px rgba(13,31,60,0.06);
    }

    .toc-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.1rem;
      color: var(--navy);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .toc-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .toc ol {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 8px 24px;
      counter-reset: toc-counter;
    }

    .toc li { counter-increment: toc-counter; }

    .toc a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 0;
      transition: color 0.2s;
    }

    .toc a:hover { color: var(--accent); }

    .toc a::before {
      content: counter(toc-counter, decimal-leading-zero);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent-light);
      min-width: 24px;
    }

    /* ── SECTIONS ── */
    section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 36px 40px;
      margin-bottom: 20px;
      box-shadow: 0 2px 12px rgba(13,31,60,0.04);
      animation: fadeUp 0.5s ease both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    section:nth-child(2)  { animation-delay: 0.05s; }
    section:nth-child(3)  { animation-delay: 0.10s; }
    section:nth-child(4)  { animation-delay: 0.15s; }
    section:nth-child(5)  { animation-delay: 0.20s; }
    section:nth-child(6)  { animation-delay: 0.25s; }
    section:nth-child(7)  { animation-delay: 0.30s; }
    section:nth-child(8)  { animation-delay: 0.35s; }
    section:nth-child(9)  { animation-delay: 0.40s; }
    section:nth-child(10) { animation-delay: 0.45s; }
    section:nth-child(11) { animation-delay: 0.50s; }
    section:nth-child(12) { animation-delay: 0.55s; }
    section:nth-child(13) { animation-delay: 0.60s; }
    section:nth-child(14) { animation-delay: 0.65s; }
    section:nth-child(15) { animation-delay: 0.70s; }
    section:nth-child(16) { animation-delay: 0.75s; }

    .section-number {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-light);
      margin-bottom: 6px;
    }

    h2 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.45rem;
      color: var(--navy);
      margin-bottom: 16px;
      line-height: 1.25;
    }

    h3 {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--blue);
      margin: 24px 0 10px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    p {
      color: var(--muted);
      font-size: 0.95rem;
      margin-bottom: 12px;
    }

    p:last-child { margin-bottom: 0; }

    ul {
      list-style: none;
      margin: 12px 0;
    }

    ul li {
      position: relative;
      padding-left: 22px;
      color: var(--muted);
      font-size: 0.95rem;
      margin-bottom: 8px;
    }

    ul li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 10px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-light);
    }

    ul li strong { color: var(--text); font-weight: 600; }

    a { color: var(--accent); }

    /* ── HIGHLIGHT BOX ── */
    .highlight-box {
      background: linear-gradient(135deg, rgba(26,60,110,0.04), rgba(46,117,182,0.06));
      border-left: 3px solid var(--accent);
      border-radius: 0 10px 10px 0;
      padding: 16px 20px;
      margin: 16px 0;
      font-size: 0.9rem;
      color: var(--blue);
      font-weight: 500;
    }

    /* ── UPDATE BADGE ── */
    .update-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(46,117,182,0.08);
      border: 1px solid rgba(46,117,182,0.2);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 100px;
      margin-bottom: 12px;
    }

    /* ── PROCESSOR TABLE ── */
    .processor-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
      margin: 16px 0;
    }
    .processor-table th {
      background: rgba(26,60,110,0.05);
      color: var(--blue);
      font-weight: 600;
      padding: 10px 14px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 0.8rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .processor-table td {
      padding: 10px 14px;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .processor-table tr:last-child td { border-bottom: none; }
    .processor-table tr:hover td { background: rgba(46,117,182,0.02); }

    /* ── CONTACT SECTION ── */
    .contact-card {
      background: linear-gradient(135deg, var(--navy), var(--blue));
      border-radius: 14px;
      padding: 28px 20px;
      margin-top: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .contact-icon {
      width: 48px; height: 48px;
      background: rgba(255,255,255,0.1);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .contact-icon svg { width: 24px; height: 24px; fill: white; }

    .contact-info { flex: 1; min-width: 200px; }
    .contact-info p { color: rgba(255,255,255,0.6); font-size: 0.82rem; margin: 0 0 4px; }
    .contact-info a { color: white; font-weight: 600; text-decoration: none; font-size: 1rem; }
    .contact-info a:hover { text-decoration: underline; }

    .contact-region {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 8px;
      padding: 8px 16px;
      color: rgba(255,255,255,0.7);
      font-size: 0.82rem;
    }

    /* ── FOOTER ── */
    footer {
      text-align: center;
      padding: 32px 24px;
      font-size: 0.82rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }

    footer span { color: var(--accent); font-weight: 500; }

    /* ── RESPONSIVE ── */
    @media (max-width: 700px) {
      section { padding: 28px 20px; }
      .toc { padding: 24px 20px; }
      .toc ol { grid-template-columns: 1fr; }
      .contact-card { flex-direction: column; }
      header { padding: 40px 20px 36px; }
      .processor-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    }
  </style>
</head>
