          gender: document.getElementById('genderValue').value,
          // chip sets
          deptChips: [...deptWorkerSelected],
          lecturerChips: [...lecturerSelected],
          // display labels for dropdowns
          roleLabel: document.getElementById('roleDisplay').textContent,
          courseLabel: document.getElementById('courseDisplay').textContent,
          campusLabel: document.getElementById('campusDisplay').textContent,
          yearLabel: document.getElementById('yearDisplay').textContent,
          expLabel: document.getElementById('expDisplay').textContent,
          monthLabel: document.getElementById('monthDisplay').textContent,
        };
        localStorage.setItem(LS_KEY, JSON.stringify(draft));
      }

      function loadDraft() {
        try { return JSON.parse(localStorage.getItem(LS_KEY)); } catch(e) { return null; }
      }

      function clearSaved() {
        localStorage.removeItem(LS_KEY);
        document.getElementById('resume-banner').classList.remove('show');
      }

      function resumeSaved() {
        const d = loadDraft();
        if (!d) return;
        document.getElementById('resume-banner').classList.remove('show');

        // Restore text fields
        if (d.username) document.getElementById('usernameS').value = d.username;
        if (d.phone) document.getElementById('phoneS').value = d.phone;

        // Restore role
        if (d.role) {
          document.getElementById('Role').value = d.role;
          currentRole = d.role;
          if (d.roleLabel) { const el = document.getElementById('roleDisplay'); el.textContent = d.roleLabel; el.classList.remove('placeholder-style'); }
        }

        // Restore course
        if (d.course) {
          document.getElementById('CourseS').value = d.course;
          if (d.courseLabel) { const el = document.getElementById('courseDisplay'); el.textContent = d.courseLabel; el.classList.remove('placeholder-style'); }
          if (d.course === 'Other') document.getElementById('course-other-wrap').classList.add('visible');
        }
        if (d.courseOther) document.getElementById('courseOtherInput').value = d.courseOther;

        // Restore dept chips
        if (d.deptChips && d.deptChips.length) {
          d.deptChips.forEach(v => { deptWorkerSelected.add(v); });
          renderDeptWorkerChips();
          syncDeptWorkerValue();
        }

        // Restore lecturer chips
        if (d.lecturerChips && d.lecturerChips.length) {
          d.lecturerChips.forEach(v => { lecturerSelected.add(v); });
          renderLecturerChips();
          syncLecturerValue();
        }

        // Restore year / experience
        if (d.year) {
          document.getElementById('Year').value = d.year;
          if (d.yearLabel) { const el = document.getElementById('yearDisplay'); el.textContent = d.yearLabel; el.classList.remove('placeholder-style'); }
        }
        if (d.expHidden) {
          document.getElementById('expHiddenValue').value = d.expHidden;
          if (d.expLabel) { const el = document.getElementById('expDisplay'); el.textContent = d.expLabel; el.classList.remove('placeholder-style'); }
        }

        // Restore campus
        if (d.campus) {
          document.getElementById('Campus').value = d.campus;
          if (d.campusLabel) { const el = document.getElementById('campusDisplay'); el.textContent = d.campusLabel; el.classList.remove('placeholder-style'); }
        }

        // Restore DOB
        if (d.dobDay) document.getElementById('dobDayInput').value = d.dobDay;
        if (d.dobMonth) {
          document.getElementById('birthMonth').value = d.dobMonth;
          if (d.monthLabel) { const el = document.getElementById('monthDisplay'); el.textContent = d.monthLabel; el.classList.remove('placeholder-style'); }
        }
        if (d.dobYear) document.getElementById('dobYearInput').value = d.dobYear;

        // Restore gender
        if (d.gender) { selectGender(d.gender); }

        // Go to saved step
        if (d.step && d.step > 1) {
          currentStep = d.step;
          showStep(currentStep);
        }
      }

      // ════════════════════════════════════════
      // SEARCHABLE DROPDOWN ENGINE
      // ════════════════════════════════════════
      function makeSearchableSelect({ displayId, dropdownId, searchId, listId, items, hiddenId, onSelect }) {
        const display  = document.getElementById(displayId);
        const dropdown = document.getElementById(dropdownId);
        const listEl   = listId ? document.getElementById(listId) : dropdown.querySelector('.searchable-select-list');
        const searchEl = searchId ? document.getElementById(searchId) : null;

        function renderList(filter) {
          listEl.innerHTML = '';
          const filtered = filter ? items.filter(i => i.toLowerCase().includes(filter.toLowerCase())) : items;
          if (!filtered.length) {
            const d = document.createElement('div');
            d.className = 'searchable-select-option no-result';
            d.textContent = 'No results found';
            listEl.appendChild(d);
            return;
          }
          filtered.forEach(item => {
            const d = document.createElement('div');
            d.className = 'searchable-select-option';
            d.textContent = item;
            d.addEventListener('mousedown', e => { e.preventDefault(); pick(item); });
            listEl.appendChild(d);
          });
        }

        function pick(val) {
          display.textContent = val;
          display.classList.remove('placeholder-style');
          if (hiddenId) document.getElementById(hiddenId).value = val;
          closeAll();
          if (onSelect) onSelect(val);
          checkIfStepIsValid();
        }

        function open() {
          closeAll();
          if (items) renderList(searchEl ? searchEl.value : '');
          dropdown.classList.add('open');
          if (searchEl) { searchEl.value = ''; searchEl.focus(); }
        }

        display.addEventListener('click', () => dropdown.classList.contains('open') ? closeAll() : open());
        display.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
        if (searchEl) searchEl.addEventListener('input', () => renderList(searchEl.value));
        if (items) renderList('');
      }

      function makeSimpleSelect({ displayId, dropdownId, hiddenId, onSelect }) {
        const display  = document.getElementById(displayId);
        const dropdown = document.getElementById(dropdownId);
        display.addEventListener('click', () => {
          if (dropdown.classList.contains('open')) { closeAll(); return; }
          closeAll(); dropdown.classList.add('open');
        });
        dropdown.querySelectorAll('.searchable-select-option').forEach(opt => {
          opt.addEventListener('mousedown', e => {
            e.preventDefault();
            display.textContent = opt.textContent.trim();
            display.classList.remove('placeholder-style');
            if (hiddenId) document.getElementById(hiddenId).value = opt.dataset.value || opt.textContent.trim();
            closeAll();
            if (onSelect) onSelect(opt.dataset.value || opt.textContent.trim(), opt.textContent.trim());
            checkIfStepIsValid();
          });
        });
      }

      function closeAll() {
        document.querySelectorAll('.searchable-select-dropdown.open').forEach(d => d.classList.remove('open'));
      }
      document.addEventListener('mousedown', e => { if (!e.target.closest('.searchable-select-wrap')) closeAll(); });

      // ── Role ──
      makeSimpleSelect({ displayId:'roleDisplay', dropdownId:'roleDropdown', hiddenId:'Role',
        onSelect(val) { currentRole = val; handleRoleChange(); }
      });

      // ── Course ──
      makeSearchableSelect({ displayId:'courseDisplay', dropdownId:'courseDropdown', searchId:'courseSearch', listId:'courseList', items:COURSE_OPTIONS, hiddenId:'CourseS',
        onSelect(val) { document.getElementById('course-other-wrap').classList.toggle('visible', val === 'Other'); }
      });

      // ── Dept worker ──
      makeSearchableSelect({ displayId:'deptDisplay', dropdownId:'deptDropdown', searchId:'deptSearch', listId:'deptList', items:DEPT_OPTIONS,
        onSelect(val) {
          if (val === 'Other') { document.getElementById('deptworker-other-wrap').classList.add('visible'); syncDeptWorkerValue(); }
          else { addDeptWorkerChip(val); }
          const d = document.getElementById('deptDisplay'); d.textContent = '-- Pick a department --'; d.classList.add('placeholder-style');
        }
      });

      // ── Lecturer ──
      makeSearchableSelect({ displayId:'lecturerDisplay', dropdownId:'lecturerDropdown', searchId:'lecturerSearch', listId:'lecturerList', items:LECTURER_OPTIONS,
        onSelect(val) {
          if (val === 'Other') { document.getElementById('lecturer-other-wrap').classList.add('visible'); syncLecturerValue(); }
          else { addLecturerChip(val); }
          const d = document.getElementById('lecturerDisplay'); d.textContent = '-- Pick a subject or field --'; d.classList.add('placeholder-style');
        }
      });

      // ── Year of study ──
      makeSimpleSelect({ displayId:'yearDisplay', dropdownId:'yearDropdown', hiddenId:'Year' });

      // ── Experience ──
      (function() {
        const listEl = document.getElementById('expList');
        EXP_OPTIONS.forEach(opt => {
          const d = document.createElement('div');
          d.className = 'searchable-select-option'; d.textContent = opt;
          d.addEventListener('mousedown', e => {
            e.preventDefault();
            document.getElementById('expHiddenValue').value = opt;
            const disp = document.getElementById('expDisplay'); disp.textContent = opt; disp.classList.remove('placeholder-style');
            document.getElementById('expNumberInput').value = '';
            closeAll(); checkIfStepIsValid();
          });
          listEl.appendChild(d);
        });
        document.getElementById('expDisplay').addEventListener('click', () => {
          if (document.getElementById('expDropdown').classList.contains('open')) { closeAll(); return; }
          closeAll(); document.getElementById('expDropdown').classList.add('open');
        });
      })();

      // ── Campus ──
      makeSearchableSelect({ displayId:'campusDisplay', dropdownId:'campusDropdown', searchId:'campusSearch', listId:'campusList', items:CAMPUS_OPTIONS, hiddenId:'Campus' });

      // ── DOB Month ──
      makeSimpleSelect({ displayId:'monthDisplay', dropdownId:'monthDropdown', hiddenId:'birthMonth' });

      // ── DOB Day typed input ──
      document.getElementById('dobDayInput').addEventListener('input', function() {
        let v = parseInt(this.value);
        if (this.value && (isNaN(v) || v < 1 || v > 31)) {
          this.classList.add('invalid');
        } else {
          this.classList.remove('invalid');
          if (!isNaN(v) && v >= 1 && v <= 31) document.getElementById('birthDay').value = String(v).padStart(2,'0');
          else document.getElementById('birthDay').value = '';
        }
        validateDOB();
        checkIfStepIsValid();
      });

      // ── DOB Year typed input ──
      document.getElementById('dobYearInput').addEventListener('input', function() {
        let v = parseInt(this.value);
        const currentYear = new Date().getFullYear();
        if (this.value.length === 4 && (isNaN(v) || v < 1900 || v > currentYear)) {
          this.classList.add('invalid');
        } else {
          this.classList.remove('invalid');
          if (!isNaN(v)) document.getElementById('birthYear').value = v;
          else document.getElementById('birthYear').value = '';
        }
        validateDOB();
        checkIfStepIsValid();
      });

      function validateDOB() {
        const day = parseInt(document.getElementById('dobDayInput').value);
        const month = document.getElementById('birthMonth').value;
        const year = parseInt(document.getElementById('dobYearInput').value);
        const errEl = document.getElementById('dobError');

        if (!day || !month || !year || String(document.getElementById('dobYearInput').value).length < 4) {
          errEl.style.display = 'none'; return false;
        }

        // Check age >= 16
        const today = new Date();
        const dob = new Date(year, parseInt(month) - 1, day);
        const age = today.getFullYear() - dob.getFullYear() - (today < new Date(today.getFullYear(), dob.getMonth(), dob.getDate()) ? 1 : 0);

        if (age < 16) {
          errEl.textContent = 'You must be at least 16 years old to join MMUN';
          errEl.style.display = 'block'; return false;
        }
        if (age > 110) {
          errEl.textContent = 'Please enter a valid birth year';
          errEl.style.display = 'block'; return false;
        }
        errEl.style.display = 'none'; return true;
      }

      // ════════════════════════════════════════
      // NAV MENU
      // ════════════════════════════════════════
      const menu = document.getElementById("Menu");
      const navigationPane = document.getElementById("HPAGELINKS");
      function showNav() {
        if (navigationPane.style.display === '' || navigationPane.style.display === 'none') {
          navigationPane.style.display = 'flex'; menu.style.transform = 'rotate(90deg)'; menu.style.scale = "0.5";
          setTimeout(() => { navigationPane.style.display = 'none'; menu.style.transform = 'rotate(0deg)'; menu.style.scale = '1'; }, 4000);
        }
      }

      setInterval(() => {
        const u = document.getElementById("usernameS");
        u.placeholder = (u.placeholder === 'e.g. Mmun_user' || u.placeholder === '') ? '|' : 'e.g. Mmun_user';
      }, 600);

      // ════════════════════════════════════════
      // STEP MANAGEMENT — 10 steps
      // 1=username 2=phone 3=pw+confirm 4=role
      // 5=course/dept/lect 6=year/exp 7=campus
      // 8=DOB 9=gender 10=profilepic
      // ════════════════════════════════════════
      let currentStep = 1;
      let currentRole = 'Student';
      const TOTAL_STEPS = 10;

      const nextBtn = document.getElementById("SUBMIT-BTN");
      const backBtn = document.getElementById("BACK-BTN");
      const form    = document.getElementById("SIGNUP-FORM");
      const errorDisplay = document.getElementById("ERROR-TEXT");

      function getStepEl(step) { return document.querySelector(`.step-${step}`); }

      function showStep(step) {
        for (let i = 1; i <= TOTAL_STEPS; i++) { const el = getStepEl(i); if (el) el.classList.add('hidden'); }
        const el = getStepEl(step); if (el) el.classList.remove('hidden');

        if (step === 5) {
          document.getElementById('student-course-wrap').classList.toggle('hidden', currentRole !== 'Student');
          document.getElementById('deptworker-wrap').classList.toggle('hidden', currentRole !== 'Department Worker');
          document.getElementById('lecturer-wrap').classList.toggle('hidden', currentRole !== 'Lecturer');
        }
        if (step === 6) {
          document.getElementById('student-year-wrap').classList.toggle('hidden', currentRole !== 'Student');
          document.getElementById('experience-wrap').classList.toggle('hidden', currentRole === 'Student');
        }

        nextBtn.textContent = step === TOTAL_STEPS ? 'Create Account' : 'Next';
        backBtn.style.display = step > 1 ? 'flex' : 'none';

        // Show login link only on step 1
        document.getElementById('loginLink').style.display = step === 1 ? 'block' : 'none';

        updateProgress(step);
        checkIfStepIsValid();
      }

      function handleRoleChange() { currentRole = document.getElementById('Role').value; checkIfStepIsValid(); }

      function selectGender(val) {
        document.querySelectorAll('.gender-card').forEach(c => c.classList.remove('selected'));
        document.querySelector(`.gender-card[data-value="${val}"]`).classList.add('selected');
        document.getElementById('genderValue').value = val;
        checkIfStepIsValid();
      }

      // ── Dept Worker chips ──
      const deptWorkerSelected = new Set();
      function addDeptWorkerChip(val) { if (!val || deptWorkerSelected.has(val)) return; deptWorkerSelected.add(val); renderDeptWorkerChips(); syncDeptWorkerValue(); }
      function removeDeptWorkerChip(val) { deptWorkerSelected.delete(val); renderDeptWorkerChips(); syncDeptWorkerValue(); }
      function renderDeptWorkerChips() {
        const container = document.getElementById('deptworker-chips'); container.innerHTML = '';
        deptWorkerSelected.forEach(val => {
          const chip = document.createElement('div'); chip.className = 'chip selected';
          chip.innerHTML = `${val} <span style="margin-left:6px;font-size:11px;cursor:pointer;" onclick="removeDeptWorkerChip('${val.replace(/'/g,"\\'")}')">✕</span>`;
          container.appendChild(chip);
        }); checkIfStepIsValid();
      }
      function syncDeptWorkerValue() {
        const other = document.getElementById('deptworkerOtherInput').value.trim();
        const all = [...deptWorkerSelected]; if (other) all.push(other);
        document.getElementById('deptworkerValue').value = all.join(', '); checkIfStepIsValid();
      }
      document.getElementById('deptworkerOtherInput').addEventListener('input', syncDeptWorkerValue);

      // ── Lecturer chips ──
      const lecturerSelected = new Set();
      function addLecturerChip(val) { if (!val || lecturerSelected.has(val)) return; lecturerSelected.add(val); renderLecturerChips(); syncLecturerValue(); }
      function removeLecturerChip(val) { lecturerSelected.delete(val); renderLecturerChips(); syncLecturerValue(); }
      function renderLecturerChips() {
        const container = document.getElementById('lecturer-chips'); container.innerHTML = '';
        lecturerSelected.forEach(val => {
          const chip = document.createElement('div'); chip.className = 'chip selected';
          chip.innerHTML = `${val} <span style="margin-left:6px;font-size:11px;cursor:pointer;" onclick="removeLecturerChip('${val.replace(/'/g,"\\'")}')">✕</span>`;
          container.appendChild(chip);
        }); checkIfStepIsValid();
      }
      function syncLecturerValue() {
        const other = document.getElementById('lecturerOtherInput').value.trim();
        const all = [...lecturerSelected]; if (other) all.push(other);
        document.getElementById('lecturerValue').value = all.join(', '); checkIfStepIsValid();
      }
      document.getElementById('lecturerOtherInput').addEventListener('input', syncLecturerValue);
      document.getElementById('courseOtherInput').addEventListener('input', checkIfStepIsValid);

      function syncExpFromNumber(val) {
        const n = parseInt(val);
        if (!isNaN(n) && n >= 0) {
          const label = n === 1 ? '1 year' : `${n} years`;
          document.getElementById('expHiddenValue').value = label;
          const disp = document.getElementById('expDisplay'); disp.textContent = '-- Choose --'; disp.classList.add('placeholder-style');
        }
        checkIfStepIsValid();
      }

      // ════════════════════════════════════════
      // USERNAME AVAILABILITY CHECK (backend)
      // ════════════════════════════════════════
      let usernameCheckTimer = null;
      let usernameAvailable  = false;
      let usernameChecking   = false;

      function setUsernameStatus(state, msg) {
        const el = document.getElementById('usernameStatus');
        el.className = state;
        el.innerHTML = state ? `<span class="status-dot"></span>${msg}` : '';
      }

      document.getElementById("usernameS").addEventListener("input", function () {
        const v = this.value.trim();
        usernameAvailable = false; usernameChecking = false; checkIfStepIsValid();
        let msg = "";
        if (!v) msg = "Username is required";
        else if (v.length < 4) msg = "Too short — minimum 4 characters";
        else if (v.length > 12) msg = "Too long — maximum 12 characters";
        else if (!/^[a-zA-Z0-9_-]+$/.test(v)) msg = "Only letters, numbers, _ or - are allowed";
        showError("usernameError", msg); setUsernameStatus('', '');
        if (msg) return;
        clearTimeout(usernameCheckTimer);
        usernameChecking = true; setUsernameStatus('checking', 'Checking availability…'); checkIfStepIsValid();
        usernameCheckTimer = setTimeout(() => {
          fetch(`/checkUsername?username=${encodeURIComponent(v)}`)
            .then(r => r.json())
            .then(data => {
              usernameChecking = false; usernameAvailable = !!data.available;
              if (data.available) { setUsernameStatus('available', `Username '${v}' is available ✓`); showError('usernameError', ''); }
              else { setUsernameStatus('taken', `Username '${v}' is already taken — try another`); showError('usernameError', 'This username is already in use'); }
              checkIfStepIsValid();
            })
            .catch(() => { usernameChecking = false; usernameAvailable = false; setUsernameStatus('taken', 'Could not verify username — please try again'); checkIfStepIsValid(); });
        }, 1500);
      });

      // ════════════════════════════════════════
      // VALIDATION
      // ════════════════════════════════════════
      function isCurrentStepValid() {
        const s = currentStep;
        if (s === 1) { const v = document.getElementById("usernameS").value.trim(); return v.length >= 4 && v.length <= 12 && /^[a-zA-Z0-9_-]+$/.test(v) && !usernameChecking && usernameAvailable; }
        if (s === 2) { return /^0(7|1)\d{8}$/.test(document.getElementById("phoneS").value.trim()); }
        if (s === 3) { const pw = document.getElementById("passwordS").value; const cf = document.getElementById("passwordCS").value; return pw.length >= 6 && pw.length <= 12 && cf.length > 0 && pw === cf; }
        if (s === 4) return !!document.getElementById("Role").value;
        if (s === 5) {
          if (currentRole === 'Student') { const v = document.getElementById('CourseS').value; if (v === 'Other') return document.getElementById('courseOtherInput').value.trim().length > 0; return !!v; }
          if (currentRole === 'Department Worker') return document.getElementById('deptworkerValue').value.trim().length > 0;
          if (currentRole === 'Lecturer') return document.getElementById('lecturerValue').value.trim().length > 0;
        }
        if (s === 6) { if (currentRole === 'Student') return !!document.getElementById('Year').value; return document.getElementById('expHiddenValue').value.trim().length > 0; }
        if (s === 7) return !!document.getElementById("Campus").value;
        if (s === 8) {
          const day = parseInt(document.getElementById('dobDayInput').value);
          const month = document.getElementById('birthMonth').value;
          const year = parseInt(document.getElementById('dobYearInput').value);
          const yearStr = document.getElementById('dobYearInput').value;
          if (!day || day < 1 || day > 31 || !month || !year || yearStr.length < 4) return false;
          return validateDOB();
        }
        if (s === 9) return !!document.getElementById("genderValue").value;
        if (s === 10) return profilePicChosen;
        return false;
      }

      document.getElementById("phoneS").addEventListener("input", function() {
        const v = this.value.trim(); let msg = "";
        if (!v) msg = "Phone number is required";
        else if (!/^0(7|1)\d{0,8}$/.test(v)) msg = "Must start with 07 or 01";
        else if (v.length < 10) msg = "Number is too short";
        else if (v.length > 10) msg = "Number is too long";
        showError("phoneError", msg); checkIfStepIsValid();
      });

      document.getElementById("passwordS").addEventListener("input", function() {
        const pw = this.value; let strength = "None", color = "#ccc", width = "0%", msg = "";
        if (!pw) msg = "Password is required";
        else if (pw.length < 6) msg = "Too short — minimum 6 characters";
        else if (pw.length > 12) msg = "Too long — maximum 12 characters";
        else {
          if (pw.length >= 10 || (pw.match(/[A-Z]/) && pw.match(/[0-9]/) && pw.match(/[^A-Za-z0-9]/))) { strength = "Strong"; color = "#4caf50"; width = "100%"; }
          else if (pw.length >= 8 || pw.match(/[A-Z]/) || pw.match(/[0-9]/)) { strength = "Medium"; color = "#ff9800"; width = "60%"; }
          else { strength = "Weak"; color = "#f44336"; width = "30%"; }
        }
        document.getElementById("strengthText").textContent = `Password strength: ${strength}`;
        document.getElementById("strengthText").style.color = color;
        document.getElementById("strengthBar").style.width = width;
        document.getElementById("strengthBar").style.background = color;
        showError("passwordError", msg); checkIfStepIsValid();
      });

      document.getElementById("passwordCS").addEventListener("input", function() {
        const pw = document.getElementById("passwordS").value; const cf = this.value; let msg = "";
        if (!cf) msg = "Please enter your confirmation password";
        else if (cf !== pw) msg = "Passwords do not match — please check and try again";
        showError("confirmError", msg); checkIfStepIsValid();
      });

      function showError(id, msg) { const el = document.getElementById(id); if (el) { el.textContent = msg; el.style.display = msg ? "block" : "none"; } }

      function updateProgress(step) {
        const pct = Math.round((step / TOTAL_STEPS) * 100);
        document.getElementById("progressPercent").textContent = pct + "%";
        document.getElementById("progressFill").style.width = pct + "%";
        const labels = { 1:"User info",2:"Contact",3:"Account security",4:"Your role",5:"About you",6:"Experience",7:"Institution",8:"Date of birth",9:"Gender",10:"Almost done" };
        document.getElementById("progressLabel").textContent = labels[step] || "Setting up";
      }

      function gotoNext() {
        if (!isCurrentStepValid()) {
          errorDisplay.textContent = "Please complete this step correctly before continuing";
          setTimeout(() => errorDisplay.textContent = "", 2500); return;
        }
        saveDraft(); // save progress on every valid step advance
        if (currentStep < TOTAL_STEPS) { currentStep++; showStep(currentStep); }
        else { openConsent(); }
      }

      function gotoBack() { if (currentStep <= 1) return; currentStep--; showStep(currentStep); }

      nextBtn.addEventListener("click", gotoNext);
      backBtn.addEventListener("click", gotoBack);
      document.getElementById("INPUTS-WRAPPER").addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); if (!nextBtn.classList.contains("unchanged")) gotoNext(); } });

      // ── Profile picture — cancel bug fix ──
      let profilePicChosen = false;
      document.getElementById("uploadPicBtn").addEventListener("click", () => { document.getElementById("profilePic").click(); });
      document.getElementById("profilePic").addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (file) { document.getElementById("profilePreview").src = URL.createObjectURL(file); document.getElementById("picFileName").textContent = `Selected: ${file.name}`; profilePicChosen = true; checkIfStepIsValid(); }
      });

      function checkIfStepIsValid() { nextBtn.classList.toggle("unchanged", !isCurrentStepValid()); }

      // ── Consent popup ──
      function openConsent() { document.getElementById('consent-overlay').classList.add('open'); }
      function closeConsent() {
        document.getElementById('consent-overlay').classList.remove('open');
        document.getElementById('consent-privacy').checked = false;
        document.getElementById('consent-about').checked = false;
        document.getElementById('consent-submit-btn').classList.remove('ready');
      }
      function checkConsent() {
        const p = document.getElementById('consent-privacy').checked;
        const a = document.getElementById('consent-about').checked;
        document.getElementById('consent-submit-btn').classList.toggle('ready', p && a);
      }
      function submitForm() {
        document.getElementById('consent-overlay').classList.remove('open');
        if (currentRole !== 'Student') { const expVal = document.getElementById('expHiddenValue').value; document.getElementById('Year').value = expVal || 'N/A'; }
        document.getElementById("loadA").classList.remove("unload");
        document.getElementById("loadB").classList.remove("unload");
        clearSaved(); // clear draft on successful submit
        form.submit();
      }

      fetch("/sysInfo").then(t=>t.json()).then(d=>{ if(!d[0].appState) document.getElementById("blocked").style.display="flex"; }).catch(()=>{});

      // ── Init ──
      backBtn.style.display = "none";
      nextBtn.classList.add("unchanged");
      showStep(1);
      updateProgress(1);

      // Show resume banner if saved draft exists and is past step 1
      const _draft = loadDraft();
      if (_draft && _draft.step && _draft.step > 1) {
        document.getElementById('resume-banner').classList.add('show');
      }
    </script>
  </body>
</html>