      const LS_KEY = 'mmun_signup_draft';

      function saveDraft() {
        const draft = {
          step: currentStep,
          username: document.getElementById('usernameS').value,
          phone: document.getElementById('phoneS').value,
          // passwords intentionally excluded
          role: document.getElementById('Role').value,
          course: document.getElementById('CourseS').value,
