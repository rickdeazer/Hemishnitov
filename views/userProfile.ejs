<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="theme-color" content="rgb(37, 4, 43)" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>MMUN - <%= user.username || "Profile" %></title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    />
    <link rel="stylesheet" href="/homepage.css"  />
    <link rel="stylesheet" href="/foreignUser.css" />
    <link rel="stylesheet" href="/userProfile.css" />

    <style>
      #postsSection {
        display: flex;
      }
    </style>
  </head>

  <body>
    <div class="app">
      <main class="content">

        <section class="profile-card"><div id="cardContainer">
          <h1 class="blogTitle <%= user.blogTitle? "" : "blogTitle"%>"><marquee loop="1" onclick="blogChanger()" direction = "left" ><%= user.blogTitle || "UNCHANGED BLOG TITLE"%></marquee></h1>
          <div class="info">
            <div class="editable-photo">
              <img
                class="profile-photo"
                src="<% if (user.profileLink) {%><%= user.profileLink%><%} else{%>/mediafiles/roseFlower.jpg<%}%>"
                alt="profile"
              />
              <input
                type="file"
                accept="image/*"
                class="photo-input"
                hidden=""
              />
            </div>

            <div id="infos">
              <div class="change" id="profName"><%=user.username%></div>
              <input
                disabled
                id="course"
                type="text"
                class="change"
                value="<%= user.course || "unset Course"%>"
              />
              <input
                disabled
                id="year"
                type="text"
                class="change"
                value="<%=user.year || "unset year"%>"
              />
            </div>

            <div id="endItems">
              <div id="viewers">
                <span id="views"
                  >Visits<span id="viewersCount"><%= user.viewsCount || 0 %></span></span
                >
                <span id="followers"
                  >Disciples <span id="followersCount"><br>0</span
                ></span>
              </div>

              <div id="insetB">
                  <button class="log-out">
                    <a>Log Out</a>
                  </button>
                  <button class="log-out">
                    <a href="/editProfile">Edit</a>
                  </button>
                </div>
            </div>
          </div>
        </div>
        </section>

        <div class="slogan">
          <span
            class="material-symbols-outlined"
            onclick="window.location.href = '/home'"
            >arrow_back</span
          >
          <%= user.slogan || "Personal slogan will appear here" %>
          <a href="/interests"
            ><span class="material-symbols-outlined"></span
          ></a>
        </div>

        <section class="gallery">
          <div class="item">
            <img src='<% if(links[0]){%><%= links[0]%><% } else {%>/mediafiles/darkgirl.jpg<%}%>' />
          </div>
          <div class="item">
            <img src='<% if(links[1]){%><%= links[1]%><% } else {%>/mediafiles/africanGirl.jpg<%}%>' alt="pic 2" />
          </div>
          <div class="item">
            <img src='<% if(links[2]){%><%= links[2]%><% } else {%>/mediafiles/darkishImagegirl.jpg<%}%>' alt="pic 3" />
          </div>
        </section>
      </main>

      <div class="middles">
        <p class="desc-title">About Me</p>
        <div class="desc-box" id="aboutMe">
          <% if (user.aboutMe) { %>
            <%= user.aboutMe %>
          <% } else { %>
            Describe yourself in a way that lets someone truly understand who you are, what excites you, and what makes you uniquely you. Share your passions, quirks, and perspectives openly, painting a picture that feels authentic and inviting. Let your words convey energy, curiosity, and warmth, so that anyone reading feels a genuine connection and the irresistible urge to reach out and explore a conversation with you. Don’t hold back on length—every detail that reflects your true self only makes the connection stronger.
          <% } %>
        </div>
      </div>

      <div class="Sociality">
        <h3>MY SOCIAL STATUS</h3>
        <div class="SocialData">
          <% if (user?.tribe) { %>
            <div class="socialItem" id="socialItem1"><h4>Tribe</h4><h5><%= user.tribe %></h5></div>
          <% } %>
          <% if (user?.relationship) { %>
            <div class="socialItem" id="socialItem2"><h4>Relationship</h4><h5><%= user.relationship %></h5></div>
          <% } %>
          <% if (user?.locality) { %>
            <div class="socialItem" id="socialItem3"><h4>Locality</h4><h5><%= user.locality %></h5></div>
          <% } %>
          <% if (user?.religion) { %>
            <div class="socialItem" id="socialItem4"><h4>Religion</h4><h5><%= user.religion %></h5></div>
          <% } %>
        </div>
      </div>

      <div class="middles">
        <p class="desc-title">About You</p>
        <div class="desc-box" id="aboutYou">
          <% if (user.aboutYou) { %>
            <%= user.aboutYou %>
          <% } else { %>
            Describe the qualities of the kind of person you can accept interests from. This will help them understand whether they share the traits and values you care about, so if they recognize these qualities in themselves, they’ll feel inspired and confident to send you an interest.
          <% } %>
        </div>
      </div>
<div class="thisProfileLink">
  <div id="socialMedia">
    <!-- Instagram -->
    <div class="socials">
      <span><%= user.instagramHandle || "|noHandle|" %>
      </span>
      <a <% if((user.instagramLink || "")=="missing"){%>style="color: red;"<%}%>  <% if(user.instagramLink && user.instagramLink.trim() != "missing"){%>href="<%= user.instagramLink%>"<%} else{%>onclick="showTonner(<% if(user.instagramLink.trim() == 'missing'){%>'no instagram profile link uploaded'<%} else {%>'instagram'<%} %>)"<%} %>>Instagram</a>
    </div>
    <!-- WhatsApp -->
<div class="socials">
  <span><%= user.whatsappHandle || '|noHandle|' %></span>

  <a <% if((user.whatsappNumber || "")=="missing"){%>style="color: red;"<%}%>
    <% if (user.whatsappPublic && (user.whatsappNumber || '').trim() !== "missing") { %> 
      href="https://wa.me/<%= (user.whatsappNumber || '').replace(/[^0-9]/g, '') %>?text=<%= encodeURIComponent(user.whatsappDefaultMsg || 'Hello, am here from MMUN, after being thrilled by your modern blog') %>"
    <% } else { %>
      onclick="showTonner('<%= (user.whatsappNumber || '').trim() === 'missing' ? 'no whatsapp number uploaded' : 'whatsapp' %>')"
    <% } %>
  >WhatsApp</a>
</div>

    <!-- Facebook -->
    <div class="socials">
      <span
          ><%=user.facebookHandle || '|noHandle|' %>
      </span>
      <a <% if((user.facebookLink || "")=="missing"){%>style="color: red;"<%}%> <% if (user.facebookPublic && user.facebookLink.trim() != "missing") {%>  href="<%= user.facebookLink || '#' %>" <% } else {%>onclick="showTonner(<% if(user.facebookLink.trim() == 'missing'){%>'no facebook profile link uploaded.'<%} else {%>'facebook'<%} %>)"<%}%>>Facebook</a>
    </div>
  </div>

  <span onclick="shareProfile('<%= user.username%>')"> Share your modern blog</span>
</div>

      <section id="postsSection">
        <h2 style="text-align: center; margin-top: 20px">
          My Posts
        </h2>
        <div class="POSTS-CONTENT"></div>
      </section>

      <div><button id="exit" onclick="exit()"></button></div>
    </div>

    <!-- Comment Drawer -->
    <div id="commentDrawerP" class="comment-drawer hidden">
      <div id="commentHeaderP">
        <span>Comments</span>
        <button id="closeCommentsP">✕</button>
      </div>
      <div id="commentListP"></div>
      <div id="commentInputContainerP">
        <input
          type="text"
          id="newCommentP"
          placeholder="Write a comment..."
        />
        <button id="sendCommentP">Send</button>
      </div>
    </div>

    <div id="overlay"></div>
        <div id="showTonner">
      <h3>Private <span id="Handle"></span></h3>
    </div>
  </body>
  <script src="/dist/userProfile.js"></script>
  <script>
   function shareProfile(user) {
  const profileUrl = `https://moispace.onrender.com/modern/${user}`;
  const shareTitle = "Modern Minds Unifying Network";
  const shareText = "This is a modern profile for a user on MMUN";

  // 🚀 1. Priority: MMUN Android App Native Bridge
  if (window.AndroidInterface && window.AndroidInterface.shareContent) {
    // We pass the URL as the text so it's clickable in messages
    window.AndroidInterface.shareContent(shareTitle, profileUrl);
    return; 
  }

  // 🌐 2. Fallback: Browser Web Share API (Standard Browsers)
  if (navigator.share) {
    navigator.share({
      title: shareTitle,
      text: shareText,
      url: profileUrl
    }).catch((err) => {
      if (err.name !== "AbortError") {
        console.warn("Web Share failed:", err);
      }
    });
  } 
  // 📋 3. Final Fallback: Manual Copy (Optional)
  else {
    if (typeof fallbackCopyLink === 'function') {
        fallbackCopyLink(profileUrl);
    }
  }
}
    function blogChanger (){
  blogTitle.innerHTML = `<span class="normalScroll"><%= user.blogTitle || "UNSET TITLE" %></span>`;
};
const marquee = document.querySelector("marquee")
setTimeout(() => {
  blogChanger()
}, marquee.scrollWidth * 14);
  </script>
  <script src="/dist/intersectionObserver.js"></script>
</html>