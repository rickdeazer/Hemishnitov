<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact – MMUN | Modern Minds Unifying Network</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy: #0D1F3C;
      --blue: #1A3C6E;
      --accent: #2E75B6;
      --accent-light: #5BA3D9;
      --gold: #C9A84C;
      --bg: #F7F8FA;
      --surface: #FFFFFF;
      --text: #1C2B3A;
      --muted: #5A6A7A;
      --border: #DDE4EC;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.65;
      font-size: 16px;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* HEADER */
    header {
      background: var(--navy);
      padding: 60px 16px 45px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 80% at 20% 50%, rgba(46,117,182,0.25) 0%, transparent 70%);
    }

    .header-inner {
      position: relative;
      z-index: 1;
      max-width: 680px;
      margin: 0 auto;
    }

    #logoImg {
      width: 68px;
      height: 68px;
      border-radius: 40%;
      box-shadow: 0 0 12px rgba(84, 183, 114, 0.6);
      margin-bottom: 14px;
    }

    .app-name {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(1.95rem, 7vw, 2.8rem);
      color: white;
      letter-spacing: -0.6px;
      line-height: 1.05;
    }

    .app-subtitle {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.7);
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-top: 5px;
    }

    .policy-badge {
      display: inline-block;
      background: rgba(201,168,76,0.18);
      border: 1px solid rgba(201,168,76,0.5);
      color: var(--gold);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 6px 18px;
      border-radius: 100px;
      margin: 20px 0 8px;
    }

    .header-tagline {
      font-family: 'DM Serif Display', serif;
      font-style: italic;
      font-size: clamp(0.95rem, 3.5vw, 1.15rem);
      color: rgba(255,255,255,0.75);
      line-height: 1.4;
    }

    /* WRAPPER */
    .wrapper {
      max-width: 940px;
      margin: 0 auto;
      padding: 30px 16px 60px;
    }

    /* SECTIONS */
    section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 24px;
      margin-bottom: 24px;
      box-shadow: 0 4px 20px rgba(13,31,60,0.05);
    }

    .section-number {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-light);
      margin-bottom: 6px;
    }

    h2 {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(1.45rem, 5.5vw, 1.7rem);
      color: white;
      margin-bottom: 14px;
      line-height: 1.2;
    }

    p {
      color: var(--muted);
      font-size: 0.96rem;
      margin-bottom: 14px;
    }

    /* CONTACT GRID - Mobile First */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 28px;
    }

    .contact-card-main {
      background: linear-gradient(135deg, var(--navy), var(--blue));
      border-radius: 16px;
      padding: 32px 24px;
      color: white;
      text-align: center;
    }

    .contact-icon-main {
      width: 64px;
      height: 64px;
      background: rgba(255,255,255,0.15);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .contact-icon-main svg {
      width: 32px;
      height: 32px;
      fill: white;
    }

    .contact-name {
      font-family: 'DM Serif Display', serif;
      font-size: 1.35rem;
      margin-bottom: 6px;
    }

    .contact-title {
      font-size: 0.93rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.45;
      margin-bottom: 24px;
    }

    .contact-link {
      display: block;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.3);
      color: white;
      padding: 14px 20px;
      border-radius: 50px;
      margin: 10px 0;
      font-weight: 500;
      font-size: 0.96rem;
    }

    .contact-link:hover {
      background: rgba(255,255,255,0.25);
    }

    .info-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px 24px;
    }

    .info-card h3 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      color: var(--navy);
      font-size: 1.05rem;
    }

    .info-icon {
      width: 38px;
      height: 38px;
      background: rgba(46,117,182,0.1);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }

    /* Dark Section */
    .dark-section {
      background: linear-gradient(135deg, var(--navy), var(--blue));
      border-radius: 16px;
      padding: 32px 24px;
      color: #fff;
    }

    /* FOOTER */
    footer {
      text-align: center;
      padding: 32px 16px;
      font-size: 0.82rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }

    /* Desktop Improvements */
    @media (min-width: 768px) {
      .wrapper { padding: 40px 24px 80px; }
      section, .dark-section { padding: 42px 36px; }
      .contact-grid { 
        grid-template-columns: 1fr 1fr; 
        gap: 26px;
      }
      .contact-card-main, .info-card { padding: 36px 30px; }
      .contact-name { font-size: 1.45rem; }
    }

    @media (max-width: 360px) {
      section, .dark-section { padding: 28px 20px; }
      .contact-card-main { padding: 28px 20px; }
      .contact-link { padding: 13px 18px; font-size: 0.94rem; }
    }
  </style>
</head>
<body>
  <header onclick="window.history.back()">
    <div class="header-inner">
      <img id="logoImg" src="/Assets/MmunLogoTopPart.png" alt="MMUN Logo" />
      <div class="app-name">MMUN</div>
      <div class="app-subtitle">Modern Minds Unifying Network</div>
      <div class="policy-badge">Contact Us</div>
      <p class="header-tagline">Where modern minds meet</p>
    </div>
  </header>

  <div class="wrapper">

    <section>
      <div class="section-number">Section 01</div>
