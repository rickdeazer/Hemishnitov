<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1B5A7B" />
    <title>MMUN</title>
    <link rel="stylesheet" href="homepage.css" />
    <link
      rel="stylesheet" 
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="body">
    <div id="HOME-PAGE">
      <!-- Header Starts Here -->
      <section id="HEADER">
        <!--Header Top Div Begins Here-->
        <div id="HEADER-TOP-DIV">
          <div id="APP-DETAILS">
            <div id="HEADER-LOGO"></div>
          </div>
          <div id="HEADER-MENU-ICONS">
            <button class="menu-icon" id="btnsHider">
              <svg width="48" height="48" viewBox="0 0 48 48">
                <defs>
                  <radialGradient id="redGlow" cx="30%" cy="30%" r="70%">
                    <stop offset="0%" stop-color="#ff6b6b" />
                    <stop offset="60%" stop-color="#ff2d2d" />
                    <stop offset="100%" stop-color="#b30000" />
                  </radialGradient>
                </defs>

                <circle cx="24" cy="24" r="22" fill="url(#redGlow)" />

                <line
                  x1="24"
                  y1="14"
                  x2="24"
                  y2="34"
                  stroke="white"
                  stroke-width="3.5"
                  stroke-linecap="round"
                />
                <line
                  x1="14"
                  y1="24"
                  x2="34"
                  y2="24"
                  stroke="white"
                  stroke-width="3.5"
                  stroke-linecap="round"
                />
              </svg>
            </button>


            <div id="addBtnCont" style="width: 40px; display: none">
              <button class="menu-icon" id="addPostBtn" title="Add Post">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <path
                    d="M12 5v14M5 12h14"
                    stroke="white"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div style="font-size: 0.6rem">New Post</div>
            </div>

            <div id="champsBtnCont" style="display: none">
              <button class="menu-icon" id="champsBtn" title="Stars">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="40"
                  height="40"
                  viewBox="0 0 64 64"
                >
                  <defs>
                    <!-- Gold gradient -->
                    <linearGradient
                      id="goldGradient"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="1"
                    >
                      <stop offset="0%" stop-color="#FFF4B0" />
                      <stop offset="35%" stop-color="#FFD700" />
                      <stop offset="70%" stop-color="#E6B800" />
                      <stop offset="100%" stop-color="#B8860B" />
                    </linearGradient>

                    <linearGradient id="shine" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="rgba(255,255,255,0.7)" />
                      <stop offset="100%" stop-color="rgba(255,255,255,0)" />
                    </linearGradient>
                  </defs>

                  <path
                    d="M20 8h24v10c0 8-6 14-12 14s-12-6-12-14V8z"
                    fill="url(#goldGradient)"
                  />

                  <path
                    d="M20 10h-6c0 8 6 12 10 12"
                    fill="none"
                    stroke="url(#goldGradient)"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <path
                    d="M44 10h6c0 8-6 12-10 12"
                    fill="none"
                    stroke="url(#goldGradient)"
                    stroke-width="4"
                    stroke-linecap="round"
                  />

                  <rect
                    x="28"
                    y="32"
                    width="8"
                    height="8"
                    fill="url(#goldGradient)"
                  />

                  <!-- Base -->
                  <rect
                    x="22"
                    y="40"
                    width="20"
                    height="6"
                    rx="2"
                    fill="#8B5A2B"
                  />
                  <rect
                    x="18"
                    y="46"
                    width="28"
                    height="6"
                    rx="2"
                    fill="#5C3A1E"
                  />

                  <!-- Shine -->
                  <path 
                    d="M24 10c0 12 6 18 6 18"
                    stroke="url(#shine)"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
              <div style="font-size: 0.6rem">Visits</div>
            </div>
          </div>
          <div id="HEADER-BTNS">
            <button
              id="CHATSH-BTN"
              class="HEADER-BTNS post"
            >
              <span id="mat2"><img class="imgSvg" src="/Assets/postsHomePage.svg" alt=""><div id="MSG-BADGE" style="scale: 0.6; background-color: red;" class="BADGE"></div></span>
            </button>
            <button
              onclick="setAndroidHeaderColor('#651E5E'); window.location.href='/chats'; "
              id=""
              class="HEADER-BTNS"
            >
              <span id="mat2"
                ><img class="imgSvg" src="/Assets/chat_24dpGREEN.svg" alt=""></span
              ><%if(unread){%>
              <div id="MSG-BADGE" class="BADGE"><%= unread%></div>
              <%}%>
            </button>

            <button
              onclick="setAndroidHeaderColor('#7D1404'); window.location.href='/interests';"
              id="INTERESTSH-BTN"
              class="HEADER-BTNS"
            >
              <span class="material-symbols-outlined"><img class="imgSvg" src="/Assets/heart_smile_24dp_75FB4C_FILL0_wght400_GRAD0_opsz24.svg" alt=""></span
              ><%if(newInterest){%>
              <div id="MSG-BADGE" class="BADGE"><%= newInterest%></div>
              <%}%>
            </button>
            <button
              onclick=" setAndroidHeaderColor('#5B2A90'); window.location.href='/notics';"
              id="NOTICS-BTN"
              class="HEADER-BTNS"
            >
              <span class="material-symbols-outlined"><img class="imgSvg" src="/Assets/notifications_24dp_75FB4C_FILL0_wght400_GRAD0_opsz24.svg" alt=""></span>
            </button>
            <button
              onclick=" setAndroidHeaderColor('#6B3A9B');window.location.href='/jobs';"
              id="NOTICS-BTN"
              class="HEADER-BTNS"
            >
              <span class="material-symbols-outlined"><img class="imgSvg" src="/Assets/business_center_24dp_75FB4C_FILL0_wght400_GRAD0_opsz24.svg" alt=""></span>
            </button>
          </div>
          
          <div
            id="USER-DETAILS"
            onclick="window.location.href = '/userProfile'"
          >
            <div id="HEADER-USERNAME"><h3 id="username"><%= user.username %></h3></div>
            <div id="HEADER-PROFILEPIC" <% if (user.profileLink) {%>
              style="background: url(<%=user.profileLink%>); background-size:
              cover;"<%}%>>
            </div>
          </div>
        </div>
        <!--Header Bottom Div Begins Here-->
        <div id="HEADER-BOTTOM-DIV">
          <div id="HEADER-APPNAME"><h2>MMUN</h2></div>
          <div id="bottomSubdiv">
            <input
              type="text"
              placeholder="..Search for users.."
              id="HOME-SEARCH"
            />
            <span class="material-symbols-outlined" id="searchInputBtn"
              >search</span
            >
          </div>
        </div>
      </section>

      <!-- Alert & Exit -->
      <div id="alertDiv">
        <span>Closing and Refreshing in: <span>5</span></span
        >Dear <%=user.username%>:
      </div>
      <a href="/home"><button id="exit" style="display: none"></button></a>

