      <section id="mainSection">
        <div class="MAIN-USERS">
          <div
            class="MAIN-USERS"
            style="position: relative; min-height: 79vh; opacity: 1"
          >
            <form method="POST" action="/user">
              <input type="hidden" name="username" value="Pat" />
            </form>
            <div
              class="MAIN-USERS-IMG"
              style="
                background-image: url('uploadsprofileprof_1762354680566_Screenshot (6).png');
                background-size: cover;
                background-position: center center;
              "
            >
              <div id="loader" class="loads">
                <div class="loadB unload"></div>
              </div>
              <div class="openComment" style="display: none">
                <svg
                  class="neon-arrow"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="#00ff99"
                >
                  <path
                    d="M5 12L12 5L19 12"
                    stroke="#00ff99"
                    stroke-width="2"
                    stroke-linecap="round"
                  ></path>
                </svg>
                <span></span>
              </div>
            </div>
            <div class="MAIN-USERS-USERNAME" style="display: none">
              <span class="Username"></span>
              <div class="mainSet">
                <div class="setOne">
                  <span class="MAIN-USERS-COURSE"></span>
                  <span class="MAIN-USERS-YEAR"></span>
                </div>
                <span class="MAIN-USERS-VIEWS"></span>
              </div>
            </div>

            <!-- Comment Section Modal -->
            <div id="COMMENT-MODAL" class="active">
              <div id="COMMENT-HEADER">
                <h3>Comment as <%= user.username %></h3>
                <button id="CLOSE-COMMENTS"></button>
              </div>
              <div id="COMMENT-INPUT">
                <div id="commentContextMenu" class="context-menu hidden">
                  <button data-action="reply">💬 Reply</button>
                  <button data-action="report">🚩 Report</button>
                  <button data-action="delete" class="danger">🗑 Delete</button>
                </div>
                <div id="COMMENT-BODY"></div>
                <input
                  type="text"
                  placeholder="Add a comment..."
                  id="NEW-COMMENT"
                />
                <button id="ADD-COMMENT">Add</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="postsSection">
               <div class="POSTS-CONTENT">
                
                <div id="loader" class="loads">
                <div class="loadB unload"></div>
              </div></div>
      </section>

      <section id="createPostSection" style="display: none">
        <div class="CREATE-POST">
          <!-- Header -->
          <div class="CREATE-POST-HEADER">
            <button id="cancelCreatePost">✕</button>
            <h3 id="createPostT">Create Post</h3>
            <button id="publishPost">Post</button>
          </div>

          <!-- User -->
          <div class="CREATE-POST-USER">
            <div
              class="user-pic"
              style="background-image: url('/myprofilepic.jpg')"
            ></div>
            <span id="nameT">~ <%=user.username%></span>
          </div>

          <!-- Text -->
          <textarea
            id="postText"
            placeholder="What’s popping at your Campus? Or is it a whole new vibe? Tell MMUN!”<%=user.username%>?"
          ></textarea>
          <div class="neon-divider"></div>

          <!-- Media Preview -->
          <div id="mediaPreview" class="MEDIA-PREVIEW hidden">
            <img id="previewImg" />
            <div id="mediaWrapper"></div>
          </div>

          <!-- Actions -->
          <div class="CREATE-POST-ACTIONS">
            <label for="postMedia" class="media-btn" id="mediaBtn">
              Click to Upload Image / short Video
            </label>

            <input
              type="file"
              id="postMedia"
              accept="image/*,video/*"
              multiple
              hidden
            />
          </div>
        </div>
      </section>

      <section id="championsSection" style="display: none">
        <h2>BLOG-VISITS LEADERBOARD <span class="closeBtn" onclick="showPeople()"> X</span></h2>

        <table id="championsTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Rating %</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </section>

      <div id="commentDrawerP" class="comment-drawer">
        <div id="commentHeaderP">
          <span>Insights</span>
          <button id="closeCommentsP">✕</button>
        </div>
        <div id="commentListP"></div>
        <div id="commentInputContainerP">
          <input
            type="text"
            id="newCommentP"
            placeholder="Write a comment..."
          />
          <button id="sendCommentP">Send</button>
        </div>
      </div>

      <div id="overlay"></div>
      <audio id="click" src="/Assets/audio/click.MP3"></audio>
      <audio id="unClick" src="/Assets/audio/unclick.MP3"></audio>
    </div>
    <!-- FINAL Upload Progress Overlay -->
<div id="uploadProgressOverlay" style="display:none;">
  <div class="upload-progress-content">
    <div class="progress-container">
      <div class="progress-bar-bg">
        <div id="uploadProgressBar" class="progress-bar-fill"></div>
      </div>
      <div id="progress-text">
        Uploading to MMUN... <span id="uploadPercent">0%</span>
      </div>
    </div>
  </div>
</div>
<div id="loaderB" class="loads unload">
                <div class="loadB unload"></div>
              </div>
  </body>
  
