<div id="toast">
  <svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
  Draft saved
</div>

<script>
// ─────────────────────────────────────────
// ROLES
// ─────────────────────────────────────────

const ROLES = [
  {
    id:'design',icon:'🎨',name:'Design Specialist',tag:'UI / UX / Branding',sub:'desSubs',
    desc:{title:'Design Specialist — Your responsibilities:',points:[
      'Design every app screen: wireframes, mockups and interactive prototypes',
      'Build and maintain a consistent design system (colors, type, spacing)',
      'Collaborate with developers to ensure pixel-perfect implementation',
      'Research competitor student apps and improve our UX continuously',
    ]},
    consents:[
      {id:'cc-ip',req:true,title:'Design Asset Ownership',body:'All design assets, mockups, prototypes and visual materials I create in this role are owned by MMUN.'},
      {id:'cc-tools',req:true,title:'Licensed Tool Usage',body:'I will only use design tools (Figma, Adobe, etc.) that I am legitimately licensed to use, and will not pirate software on behalf of MMUN.'},
    ]
  },
  {
    id:'features',icon:'💡',name:'Feature Specialist',tag:'Product / Research',sub:null,
    desc:{title:'Feature Specialist — Your responsibilities:',points:[
      'Research what features students need and translate them into feature briefs',
      'Study competitor apps and identify gaps MMUN can fill',
      'Prioritize features by student value and technical feasibility',
      'Gather beta feedback and iterate with the dev and design teams',
    ]},
    consents:[
      {id:'cc-research',req:true,title:'Ethical Research Conduct',body:'I will conduct user research ethically — no misleading participants, fabricating data, or sharing participant identities without consent.'},
    ]
  },
  {
    id:'stakeholders',icon:'🤝',name:'Shares & Stakeholders',tag:'Strategy / Advisory',sub:null,
    desc:{title:'Shares & Stakeholders — Your responsibilities:',points:[
      'Provide strategic direction and high-level guidance to the core team',
      'Represent investor and advisor interests in key product decisions',
      'Help unlock resources, networks, and external partnerships',
      'Hold the team accountable to long-term goals and vision',
    ]},
    consents:[
      {id:'cc-conflict',req:true,title:'Conflict of Interest Disclosure',body:'I will disclose any financial or professional conflicts of interest that may influence my decisions as a stakeholder.'},
      {id:'cc-fiduciary',req:true,title:'Fiduciary Responsibility',body:'I will act in the best interests of MMUN and its users, not solely for personal gain.'},
    ]
  },
  {
    id:'marketing',icon:'📣',name:'Marketing & Monetization',tag:'Growth / Content / Ads',sub:'mktSubs',
    desc:{title:'Marketing & Monetization — Your responsibilities:',points:[
      'Build and manage MMUN\'s social media presence and content calendar',
      'Plan and execute on-campus campaigns and launch events',
      'Research monetization strategies (ads, subscriptions, partnerships)',
      'Track growth KPIs and report on user acquisition weekly',
    ]},
    consents:[
      {id:'cc-honest',req:true,title:'Honest Marketing',body:'I will not use misleading, exaggerated or false claims when marketing MMUN to students or partners.'},
      {id:'cc-brand',req:true,title:'Brand Voice Consistency',body:'All content I publish on behalf of MMUN will go through the founder\'s approval and remain consistent with the official brand voice.'},
    ]
  },
  {
    id:'developer',icon:'💻',name:'Developer',tag:'Frontend / Backend / Full Stack / Mobile',sub:'devSubs',
    desc:{title:'Developer — Your responsibilities:',points:[
      'Build and maintain the MMUN app across web and/or mobile platforms',
      'Implement UI designs accurately from the Design Specialist team',
      'Develop secure backend APIs, databases, and server infrastructure',
      'Write clean, documented, testable code and handle bugs promptly',
    ]},
    consents:[
      {id:'cc-ai',req:true,title:'Responsible Use of AI Tools',body:'I will use AI coding tools (GitHub Copilot, ChatGPT, Claude, etc.) responsibly. I will review all AI-generated code before committing, will not blindly ship AI output, and will not use AI to introduce vulnerabilities or deceptive logic into the codebase.'},
      {id:'cc-security',req:true,title:'Security & Data Handling',body:'I will follow secure coding practices. I will never expose user data, hardcode secrets, or bypass authentication logic — even in development or testing environments.'},
      {id:'cc-code-own',req:true,title:'Code Ownership & No External Repos',body:'All code I write for MMUN belongs to MMUN. I will not push project code to personal or external repositories without explicit written permission.'},
    ]
  },
  {
    id:'feedback',icon:'📋',name:'Feedback Coordinator',tag:'User Research / QA',sub:null,
    desc:{title:'Feedback Coordinator — Your responsibilities:',points:[
      'Run surveys, user interviews, and beta testing sessions with students',
      'Collect, categorize and analyze bug reports and feature requests',
      'Present clear, actionable feedback reports to the team weekly',
      'Act as the authentic voice of the user in all internal discussions',
    ]},
    consents:[
      {id:'cc-privacy',req:true,title:'User Data Privacy',body:'I will anonymize feedback where appropriate and never share individual user responses without their explicit consent.'},
    ]
  },
];

// ─────────────────────────────────────────
// SHARED CONSENTS (all roles)
// ─────────────────────────────────────────
const SHARED_CONSENTS = [
  {id:'cc-nda',req:true,title:'Confidentiality & Non-Disclosure',body:'I will keep all MMUN internal information — ideas, code, strategies, financials, and communications — strictly confidential during and after my time on the team.'},
  {id:'cc-ip-gen',req:true,title:'Intellectual Property',body:'All work I produce in my role belongs to MMUN. I waive any personal ownership claim over deliverables created for this team.'},
  {id:'cc-commit',req:true,title:'Commitment & Accountability',body:'I will honour my stated availability and communicate proactively if I cannot meet a deadline. Repeated no-shows without notice may result in removal.'},
  {id:'cc-conduct',req:true,title:'Code of Conduct',body:'I will treat all teammates with respect. No harassment, discrimination, or hostile behaviour. Misconduct may result in immediate removal.'},
  {id:'cc-accuracy',req:true,title:'Data Accuracy & Consent',body:'All information I have provided is true. I consent to MMUN storing it for team management. My data will not be sold to third parties.'},
];

// ─────────────────────────────────────────
// STATE
// ─────────────────────────────────────────
let currentPage = 0;
const TOTAL_PAGES = 5;
let selectedRole = null;
let selectedSub = null;
let skills = [];
let hasSig = false;
let accountData = null; // from backend
let sigBlob = null;

// ─────────────────────────────────────────
// DOTS
// ─────────────────────────────────────────
function renderDots() {
  const wrap = document.getElementById('stepDots');
  wrap.innerHTML = '';
  for (let i = 0; i < TOTAL_PAGES; i++) {
    const d = document.createElement('div');
    d.className = 'dot' + (i === currentPage ? ' active' : i < currentPage ? ' done' : '');
    wrap.appendChild(d);
  }
  const labels = ['Consent','Role','Your Details','Skills','Sign & Submit'];
  document.getElementById('stepLbl').textContent = labels[currentPage] || '';
}

// ─────────────────────────────────────────
// RENDER ROLES
// ─────────────────────────────────────────
const grid = document.getElementById('roleGrid');
ROLES.forEach(r => {
  const c = document.createElement('div');
  c.className = 'role-card'; c.dataset.id = r.id;
  c.innerHTML = `<input type="radio" name="role" value="${r.id}"/>
    <div class="r-ck"></div>
    <div class="r-icon">${r.icon}</div>
    <div class="r-name">${r.name}</div>
    <div class="r-tag">${r.tag}</div>`;
  c.onclick = () => pickRole(r.id);
  grid.appendChild(c);
});

function pickRole(id) {
  selectedRole = id;
  selectedSub = null;
  document.querySelectorAll('.role-card').forEach(c => c.classList.remove('sel'));
  document.querySelector(`.role-card[data-id="${id}"]`).classList.add('sel');
  document.querySelectorAll('.sub-row').forEach(s => s.classList.remove('show'));
  const r = ROLES.find(x => x.id === id);
  if (r.sub) document.getElementById(r.sub).classList.add('show');
  document.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('on'));
  document.getElementById('rdTitle').textContent = r.desc.title;
  document.getElementById('rdList').innerHTML = r.desc.points.map(p => `<li>${p}</li>`).join('');
  document.getElementById('roleDesc').style.display = 'block';
  document.getElementById('roleErr').classList.remove('show');
  buildConsents();
  autoSave();
}

function setSub(btn, rowId) {
  document.querySelectorAll(`#${rowId} .sub-btn`).forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  selectedSub = btn.dataset.v;
  autoSave();
}

// ─────────────────────────────────────────
// BUILD ROLE-BASED CONSENTS
// ─────────────────────────────────────────
function buildConsents() {
  if (!selectedRole) return;
  const r = ROLES.find(x => x.id === selectedRole);
  const all = [...(r.consents || []), ...SHARED_CONSENTS];
  const list = document.getElementById('compList');
  list.innerHTML = '';
  all.forEach(c => {
    const lbl = document.createElement('label');
    lbl.className = 'consent-item' + (c.req ? ' required-c' : '');
    lbl.setAttribute('onclick', 'toggleConsent(this)');
    lbl.innerHTML = `<input type="checkbox" onclick="toggleConsent(this.parentElement)" id="${c.id}" ${c.req ? 'data-req="true"' : ''}/>
      <div class="c-body">
        <strong>${c.title}${c.req ? ' <span style="color:var(--error)">*</span>' : ''}</strong>
        <span>${c.body}</span>
      </div>`;
    list.appendChild(lbl);
  });
}

// ─────────────────────────────────────────
// CONSENT TOGGLE
// ─────────────────────────────────────────
function toggleConsent(label) {
  const cb = label.querySelector('input');
  if (cb) { cb.checked = !cb.checked; label.classList.toggle('on', cb.checked); }
}

// ─────────────────────────────────────────
// SKILLS
// ─────────────────────────────────────────
document.getElementById('skillInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); addSkill(); }
});

function addSkill() {
  const inp = document.getElementById('skillInput');
  const v = inp.value.trim();
  if (!v) return;
  if (skills.map(s => s.toLowerCase()).includes(v.toLowerCase())) { inp.value = ''; return; }
  if (skills.length >= 20) { showToast('Maximum 20 skills'); return; }
  skills.push(v);
  renderTags();
  inp.value = '';
  document.getElementById('e-skills').classList.remove('show');
  autoSave();
}

function removeSkill(s) {
  skills = skills.filter(x => x !== s);
  renderTags();
  autoSave();
}

function renderTags() {
  document.getElementById('tagsWrap').innerHTML = skills.map(s =>
    `<div class="tag">${escHtml(s)}<button type="button" onclick="removeSkill('${s.replace(/'/g, "\\'")}')">×</button></div>`
  ).join('');
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ─────────────────────────────────────────
// DAYS
// ─────────────────────────────────────────
function toggleDay(btn) { btn.classList.toggle('on'); autoSave(); }

// ─────────────────────────────────────────
// SIGNATURE
// ─────────────────────────────────────────
const canvas = document.getElementById('sig');
const ctx = canvas.getContext('2d');
let drawing = false;

function resizeSig() {
  const r = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  const prevData = hasSig ? canvas.toDataURL() : null;
  canvas.width = r.width * dpr; canvas.height = r.height * dpr;
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#0D1F3C'; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  if (prevData && hasSig) {
    const img = new Image(); img.src = prevData;
    img.onload = () => ctx.drawImage(img, 0, 0, r.width, r.height);
  }
}
window.addEventListener('resize', resizeSig);
function exit(){
  let editBeacon = localStorage.getItem('editAuthBeacon') || null;
  if(editBeacon){
    window.location.href = "/home";
    localStorage.removeItem("editAuthBeacon");
  } else {
    window.history.back()
  }
  
}
function getP(e) {
  const r = canvas.getBoundingClientRect();
  if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}

canvas.addEventListener('mousedown', e => { drawing = true; const p = getP(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); });
canvas.addEventListener('mousemove', e => { if (!drawing) return; const p = getP(e); ctx.lineTo(p.x, p.y); ctx.stroke(); hasSig = true; document.getElementById('e-sig').classList.remove('show'); });
canvas.addEventListener('mouseup', () => { drawing = false; captureBlob(); });
canvas.addEventListener('mouseleave', () => { drawing = false; });
canvas.addEventListener('touchstart', e => { e.preventDefault(); drawing = true; const p = getP(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }, { passive: false });
canvas.addEventListener('touchmove', e => { e.preventDefault(); if (!drawing) return; const p = getP(e); ctx.lineTo(p.x, p.y); ctx.stroke(); hasSig = true; }, { passive: false });
canvas.addEventListener('touchend', () => { drawing = false; captureBlob(); });

function captureBlob() {
  canvas.toBlob(b => { sigBlob = b; }, 'image/png');
}

function clearSig() {
  const r = canvas.getBoundingClientRect();
  ctx.clearRect(0, 0, r.width, r.height);
  hasSig = false; sigBlob = null;
}

// ─────────────────────────────────────────
// VALIDATION PER PAGE
// ─────────────────────────────────────────
function validatePage(page) {
  if (page === 0) {
    const ok = document.getElementById('consentPrefill').checked;
    document.getElementById('consentErr').classList.toggle('show', !ok);
    return ok;
  }
  if (page === 1) {
    if (!selectedRole) { document.getElementById('roleErr').classList.add('show'); return false; }
    return true;
  }
  if (page === 2) {
    let ok = true;
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const fields = [
      { id: 'firstName', check: v => v.trim().length > 0 },
      { id: 'lastName', check: v => v.trim().length > 0 },
      { id: 'email', check: v => emailRe.test(v.trim()), msg: 'Enter a valid email address' },
      { id: 'phone', check: v => v.trim().length >= 7 },
      { id: 'dob', check: v => v.trim().length > 0 },
      { id: 'institution', check: v => v.trim().length > 0 },
      { id: 'programme', check: v => v.trim().length > 0 },
      { id: 'acYear', check: v => v.trim().length > 0 },
      { id: 'gender', check: v => v.trim().length > 0 },
    ];
    fields.forEach(f => {
      const el = document.getElementById(f.id);
      const errEl = document.getElementById(`e-${f.id}`);
      if (!f.check(el.value)) {
        el.classList.add('err');
        if (errEl) errEl.classList.add('show');
        ok = false;
      } else {
        el.classList.remove('err');
        if (errEl) errEl.classList.remove('show');
      }
    });
    if (!ok) scrollToFirst('.err');
    return ok;
  }
  if (page === 3) {
    let ok = true;
    if (skills.length === 0) { document.getElementById('e-skills').classList.add('show'); ok = false; }
    const simple = ['skillLevel','hours','motivation'];
    simple.forEach(id => {
      const el = document.getElementById(id);
      const errEl = document.getElementById(`e-${id}`);
      if (!el.value.trim()) { el.classList.add('err'); errEl && errEl.classList.add('show'); ok = false; }
      else { el.classList.remove('err'); errEl && errEl.classList.remove('show'); }
    });
    // motivation min length
    const mot = document.getElementById('motivation');
    if (mot.value.trim().length < 20) { mot.classList.add('err'); document.getElementById('e-motivation').classList.add('show'); ok = false; }
    if (!ok) scrollToFirst('.err');
    return ok;
  }
  if (page === 4) {
    let ok = true;
    // All required checkboxes
    const required = document.querySelectorAll('#compList [data-req="true"]');
    let allChecked = true;
    required.forEach(cb => { if (!cb.checked) allChecked = false; });
    if (!allChecked) { document.getElementById('compErr').classList.add('show'); ok = false; }
    else document.getElementById('compErr').classList.remove('show');
    // Signature
    if (!hasSig) { document.getElementById('e-sig').classList.add('show'); ok = false; }
    else document.getElementById('e-sig').classList.remove('show');
    // Legal name
    const ln = document.getElementById('legalName');
    const lnErr = document.getElementById('e-legalName');
    if (!ln.value.trim()) { ln.classList.add('err'); lnErr.classList.add('show'); ok = false; }
    else { ln.classList.remove('err'); lnErr.classList.remove('show'); }
    return ok;
  }
  return true;
}

function scrollToFirst(selector) {
  const el = document.querySelector('.page.active ' + selector);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// ─────────────────────────────────────────
// PAGE NAVIGATION
// ─────────────────────────────────────────
function goTo(next) {
  const cur = document.getElementById(`p${currentPage}`);
  const nxt = document.getElementById(`p${next}`);
  cur.classList.add('exit');
  cur.addEventListener('animationend', () => {
    cur.classList.remove('active', 'exit');
    cur.style.opacity = '0'; cur.style.pointerEvents = 'none';
  }, { once: true });
  setTimeout(() => {
    nxt.style.opacity = ''; nxt.style.pointerEvents = '';
    nxt.classList.add('active', 'enter');
    nxt.scrollTop = 0;
    nxt.addEventListener('animationend', () => nxt.classList.remove('enter'), { once: true });
  }, 200);
  currentPage = next;
  renderDots();
}

function goNext(page) {
  if (!validatePage(page)) return;
  if (page === 0) { applyPrefill(); }
  goTo(page + 1);
  autoSave();
}

function goPrev(page) {
  if (page > 0) goTo(page - 1);
}

// ─────────────────────────────────────────
// PREFILL FROM BACKEND DATA
// ─────────────────────────────────────────
function applyPrefill() {
  if (!accountData) return;
  const pf = (id, val) => {
    const el = document.getElementById(id);
    if (el && val) { el.value = val; el.classList.add('prefilled'); }
  };

  // DOB
  if (accountData.birthYear && accountData.birthMonth && accountData.birthDay) {
    const m = String(accountData.birthMonth).padStart(2, '0');
    const d = String(accountData.birthDay).padStart(2, '0');
    pf('dob', `${accountData.birthYear}-${m}-${d}`);
  }

  // Gender
  pf('gender', accountData.gender);

  // Contact
  pf('phone', accountData.whatsappNumber || accountData.phone);

  // Academic
  pf('institution', accountData.Institution);
  pf('programme', accountData.course);

  // Username as first name
  pf('firstName', accountData.username);
  pf('legalName', accountData.username);

  // Year — handles DB typos like "Forth Year"
  const yearMap = {
    'First Year':  'First Year',  'Year 1': 'First Year',
    'Second Year': 'Second Year', 'Year 2': 'Second Year',
    'Third Year':  'Third Year',  'Year 3': 'Third Year',
    'Fourth Year': 'Fourth Year', 'Year 4': 'Fourth Year', 'Forth Year': 'Fourth Year',
    'Fifth Year':  'Fifth Year',  'Year 5': 'Fifth Year',
    'Postgraduate': 'Postgraduate',
    'Graduated': 'Graduated',
  };
  const mappedYear = yearMap[accountData.year] || accountData.year;
  const acYr = document.getElementById('acYear');
  for (let opt of acYr.options) {
    if (opt.value === mappedYear) { acYr.value = mappedYear; acYr.classList.add('prefilled'); break; }
  }
}
// ─────────────────────────────────────────
// FETCH ACCOUNT DATA
// ─────────────────────────────────────────
async function loadAccount() {
  try {
    const res = await fetch('/profile', { credentials: 'include' });
    if (!res.ok) throw new Error('Not authenticated');
    const data = await res.json();
    accountData = data;
    // Populate preview
    const img = document.getElementById('previewImg');
    img.src = data.profileLink || '';
    document.getElementById('previewName').textContent = data.username || 'MMUN Member';
    document.getElementById('previewMeta').textContent =
      [data.Institution, data.course, data.year].filter(Boolean).join(' · ');
    document.getElementById('previewRole').textContent = data.Role || 'Student';
  } catch (e) {
    document.getElementById('previewName').textContent = 'Could not load profile';
    document.getElementById('previewMeta').textContent = 'Make sure you are logged in';
  }
}

// ─────────────────────────────────────────
// AUTO-SAVE (localStorage)
// ─────────────────────────────────────────
function gather() {
  const days = [];
  document.querySelectorAll('.day.on').forEach(b => days.push(b.textContent));
  return {
    firstName: document.getElementById('firstName')?.value || '',
    lastName: document.getElementById('lastName')?.value || '',
    email: document.getElementById('email')?.value || '',
    phone: document.getElementById('phone')?.value || '',
    dob: document.getElementById('dob')?.value || '',
    gender: document.getElementById('gender')?.value || '',
    institution: document.getElementById('institution')?.value || '',
    programme: document.getElementById('programme')?.value || '',
    acYear: document.getElementById('acYear')?.value || '',
    selectedRole, selectedSub, skills,
    skillLevel: document.getElementById('skillLevel')?.value || '',
    hours: document.getElementById('hours')?.value || '',
    portfolio: document.getElementById('portfolio')?.value || '',
    motivation: document.getElementById('motivation')?.value || '',
    days,
    legalName: document.getElementById('legalName')?.value || '',
    currentPage,
  };
}

let saveTimer;
function autoSave() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    if (!document.getElementById('consentSave')?.checked) return;
    try { localStorage.setItem('mmun_app_v2', JSON.stringify(gather())); showToast('Draft saved'); } catch(e) {}
  }, 700);
}

function restoreDraft(d) {
  const s = (id, v) => { const el = document.getElementById(id); if (el && v) el.value = v; };
  s('firstName',d.firstName); s('lastName',d.lastName); s('email',d.email);
  s('phone',d.phone); s('dob',d.dob); s('gender',d.gender);
  s('institution',d.institution); s('programme',d.programme); s('acYear',d.acYear);
  s('skillLevel',d.skillLevel); s('hours',d.hours); s('portfolio',d.portfolio);
  s('motivation',d.motivation); s('legalName',d.legalName);
  if (d.skills) { skills = d.skills; renderTags(); }
  if (d.selectedRole) setTimeout(() => pickRole(d.selectedRole), 50);
  if (d.selectedSub) setTimeout(() => {
    document.querySelectorAll('.sub-btn').forEach(b => { if (b.dataset.v === d.selectedSub) { b.click(); } });
  }, 150);
  if (d.days) document.querySelectorAll('.day').forEach(b => { if (d.days.includes(b.textContent)) b.classList.add('on'); });
}

// ─────────────────────────────────────────
// SUBMIT
// ─────────────────────────────────────────
async function submitForm() {
  if (!validatePage(4)) return;

  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div> Uploading signature…';

  showLoading('Uploading your signature…');

  let signatureUrl = null;

  try {
    // 1. Upload signature PNG to backend → ImageKit
    if (!sigBlob) {
      // Capture fresh blob
      await new Promise(resolve => canvas.toBlob(b => { sigBlob = b; resolve(); }, 'image/png'));
    }
    const formData = new FormData();
    formData.append('image', sigBlob, `sig_${Date.now()}.png`);

    const uploadRes = await fetch('/upload-signature', {
      method: 'POST',
      body: formData,
      credentials: 'include',
    });

    if (!uploadRes.ok) {
      const err = await uploadRes.json().catch(() => ({}));
      throw new Error(err.message || 'Signature upload failed');
    }
    const uploadData = await uploadRes.json();
    if (!uploadData.success || !uploadData.url) throw new Error('Signature upload returned no URL');
    signatureUrl = uploadData.url;

    // 2. Submit application
    showLoading('Submitting your application…');
    btn.innerHTML = '<div class="spinner"></div> Submitting…';

    const days = [];
    document.querySelectorAll('.day.on').forEach(b => days.push(b.textContent));

    const payload = {
      // Personal
      firstName: document.getElementById('firstName').value.trim(),
      lastName: document.getElementById('lastName').value.trim(),
      email: document.getElementById('email').value.trim(),
      phone: document.getElementById('phone').value.trim(),
      dob: document.getElementById('dob').value,
      gender: document.getElementById('gender').value,
      // Academic
      institution: document.getElementById('institution').value.trim(),
      programme: document.getElementById('programme').value.trim(),
      acYear: document.getElementById('acYear').value,
      // Role
      role: selectedRole,
      roleSpecialization: selectedSub || null,
      // Skills
      skills,
      skillLevel: document.getElementById('skillLevel').value,
      hoursPerWeek: document.getElementById('hours').value,
      portfolio: document.getElementById('portfolio').value.trim(),
      motivation: document.getElementById('motivation').value.trim(),
      availableDays: days,
      // Signature
      signatureUrl,
      legalName: document.getElementById('legalName').value.trim(),
      submittedAt: new Date().toISOString(),
    };

    const submitRes = await fetch('/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(payload),
    });

    const result = await submitRes.json().catch(() => ({}));

    if (!submitRes.ok) {
      throw new Error(result.message || `Server error (${submitRes.status})`);
    }

    // 3. Success
    localStorage.removeItem('mmun_app_v2');
    hideLoading();
    showSuccess();

  } catch (err) {
    hideLoading();
    btn.disabled = false;
    btn.innerHTML = 'Submit Application <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>';
    // If offline — save locally and queue
    if (!navigator.onLine) {
      const cached = { ...gather(), signatureDataUrl: canvas.toDataURL('image/png') };
      localStorage.setItem('mmun_pending_submit', JSON.stringify(cached));
      showToast('Saved offline — will auto-submit when you reconnect');
      window.addEventListener('online', retrySubmit, { once: true });
    } else {
      alert(`Submission failed: ${err.message}\n\nYour draft is saved — please try again.`);
    }
  }
}

async function retrySubmit() {
  const pending = localStorage.getItem('mmun_pending_submit');
  if (!pending) return;
  try {
    // Re-attempt via the normal flow — user needs to re-sign if page was refreshed
    // But payload data is preserved in draft
    showToast('Back online! Please re-submit your application.');
  } catch(e) {}
}

function showSuccess() {
  const cur = document.getElementById(`p${currentPage}`);
  cur.classList.add('exit');
  cur.addEventListener('animationend', () => { cur.classList.remove('active', 'exit'); }, { once: true });
  setTimeout(() => {
    const s = document.getElementById('successPage');
    s.classList.add('active', 'enter');
    s.addEventListener('animationend', () => s.classList.remove('enter'), { once: true });
  }, 220);
  document.getElementById('stepDots').innerHTML = '';
  document.getElementById('stepLbl').textContent = '✓ Done';
}

// ─────────────────────────────────────────
// UI HELPERS
// ─────────────────────────────────────────
function showLoading(msg) {
  document.getElementById('loadingMsg').textContent = msg || 'Please wait…';
  document.getElementById('loadingOverlay').classList.add('show');
}
function hideLoading() { document.getElementById('loadingOverlay').classList.remove('show'); }

let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  if (msg) t.childNodes[1].textContent = ' ' + msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2400);
}

// ─────────────────────────────────────────
// INIT
// ─────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  renderDots();
  resizeSig();
  loadAccount();
  const alrdyApplied = `<%=status.existing%>`
  if(alrdyApplied == "true"){
    showSuccess();
  }

  // Restore draft
  try {
    const d = localStorage.getItem('mmun_app_v2');
    if (d) restoreDraft(JSON.parse(d));
  } catch(e) {}

  // Auto-save on all inputs
  document.addEventListener('input', autoSave);
  document.addEventListener('change', autoSave);

  // Clear errors on fix
  document.querySelectorAll('input,select,textarea').forEach(el => {
    el.addEventListener('input', () => {
      el.classList.remove('err');
      const errEl = document.getElementById(`e-${el.id}`);
      if (errEl) errEl.classList.remove('show');
    });
  });
});

</script>
