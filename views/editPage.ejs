  <script>
      const aboutMe = document.getElementById('aboutMe');
  const aboutYou = document.getElementById('aboutYou');
  const aboutYouText = "Describe the qualities of the kind of person you can accept interests from. This will help them understand whether they share the traits and values you care about, so if they recognize these qualities in themselves, they’ll feel inspired and confident to send you an interest. How should that person be?";
  const aboutMeText = "Describe yourself in a way that lets someone truly understand who you are, what excites you, and what makes you uniquely you. Share your passions, quirks, and perspectives openly, painting a picture that feels authentic and inviting. Let your words convey energy, curiosity, and warmth, so that anyone reading feels a genuine connection and the irresistible urge to reach out and explore a conversation with you. Don’t hold back on length—every detail that reflects your true self only makes the connection stronger.";

  aboutMe.addEventListener('focus',()=>{
    if(aboutMe.innerText.trim() == aboutMeText.trim()){
      aboutMe.innerText = "";
    }
  });
  aboutMe.addEventListener('blur',()=>{
    if(aboutMe.innerText.trim() == ""){
      aboutMe.innerText = aboutMeText;
    }
  });
  aboutYou.addEventListener('focus',()=>{
    if(aboutYou.innerText.trim() == aboutYouText.trim()){
      aboutYou.innerText = "";
    }
  });
  aboutYou.addEventListener('blur',()=>{
    if (aboutYou.innerText.trim() == ""){
      aboutYou.innerText = aboutYouText;}
  })

  document.getElementById('openEdit').onclick = function() {
    document.getElementById('editModal').style.display = 'flex';
  };

  document.getElementById('closeModal').onclick = function() {
    const allEdits = document.querySelectorAll(".edited");
    let editCounts = 0;
    allEdits.forEach((item)=>{
      editCounts ++;
    });
     if(allEdits.length){
    const result = confirm(`You have made ${editCounts} ${editCounts == 1? "change": "changes"}. Do do you want to drop ${editCounts == 1? "it": "them"} and exit?`);
      if (result){
      window.history.back();
      }
     } else{
      window.history.back();
     }
  };


  document.getElementById('editModal').onclick = function(e) {
    if (e.target === this) this.style.display = 'none';
  };

  const username = localStorage.getItem("mainUser") || "your_username_here";

  const changedImages = [];

document.addEventListener('DOMContentLoaded', () => {
  // Profile photo
  const profileLink = '<%= user.profileLink %>';
  function preloadImage(previewId, imgUrl) {
    if (!imgUrl) return;
    const preview = document.getElementById(previewId);
    if (!preview) return;
    const img = document.createElement('img');
    img.src = imgUrl;  
    preview.appendChild(img);
  }

  // Preload profile image
  preloadImage('profilePreview', profileLink);

  // Gallery images
  const serverLinks = ('<%= links %>' || '').split(',');
  preloadImage('gal0Preview', serverLinks[0]);
  preloadImage('gal1Preview', serverLinks[1]);
  preloadImage('gal2Preview', serverLinks[2]);
});









  

  // === IMAGE SETUP (preview + tracking) ===
  function setupImageUpload(inputId, backendField, index = null) {
    const input = document.getElementById(inputId);
    const previewDiv = document.getElementById(
      inputId === 'profilePhoto' ? 'profilePreview' : inputId.replace('gallery', 'gal') + 'Preview'
    );
    const btn = input.closest('.file-upload-wrapper').querySelector('.file-upload-btn');
    const fileNameEl = document.getElementById(
      inputId === 'profilePhoto' ? 'profileName' : inputId.replace('gallery', 'gal') + 'Name'
    );

    input.addEventListener('change', function() {
      const file = this.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = e => {
          let img = previewDiv.querySelector('img');
          if (!img) {
            img = document.createElement('img');
            previewDiv.appendChild(img);
          }
          img.src = e.target.result;
          img.classList.add('edited');
        };
        reader.readAsDataURL(file);

        fileNameEl.textContent = file.name;
        btn.classList.add('edited');

        const obj = { field: backendField === 'profile' ? 'prof' : 'gallery', index, file };
        const existingIdx = changedImages.findIndex(ci => ci.field === obj.field && ci.index === obj.index);
        if (existingIdx >= 0) changedImages[existingIdx] = obj;
        else changedImages.push(obj);
      } else {
        previewDiv.innerHTML = '';
        fileNameEl.textContent = 'No file chosen';
        btn.classList.remove('edited');
        const idx = changedImages.findIndex(ci => ci.field === (backendField === 'profile' ? 'prof' : 'gallery') && ci.index === index);
        if (idx >= 0) changedImages.splice(idx, 1);
      }
    });
  }

  setupImageUpload('profilePhoto', 'profile');
  setupImageUpload('gallery0', 'gallery', 0);
  setupImageUpload('gallery1', 'gallery', 1);
  setupImageUpload('gallery2', 'gallery', 2);

  // === TEXT TRACKING ===
const textFields = [
  'blogTitle',
  'slogan',
  'course',
  'year',
  'tribe',
  'relationship',
  'locality',
  'religion',
  'skinColor',
  'eyeColor',
  'favoriteColor',
  'favoriteFood',
  'bestFriend',
  'favoriteMovie',
  'hobbies',
  'favoriteBook',
  'favoriteMusic',
  'aboutMe',
  'aboutYou',
  'instagramHandle',
  'instagramLink',
  'whatsappHandle',
  'whatsappNumber',
  'facebookHandle',
  'facebookLink',
  'whatsappDefaultMsg'
];


  textFields.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.dataset.modified = "false";
    el.addEventListener('input', () => {
      if(el.textContent !== aboutMeText && el.textContent !== aboutYouText){
        el.dataset.modified = "true";
        el.classList.add('edited'); 
      }
    });
    if (el.tagName === 'SELECT') {
      el.addEventListener('change', () => {
        el.dataset.modified = "true";
        el.classList.add('edited');
      });
    }
  });

const privacyFields = [
  'tribe',
  'relationship',
  'locality',
  'religion', 
  'instagram',
  'whatsapp',
  'facebook'
];

privacyFields.forEach((field)=>{
  let element = document.getElementById(field + "Public");
  if (!element) return;
  element.addEventListener('change',()=>{
  element.dataset.modified = true;
  })
})

  async function uploadChangedImages() {
    if (changedImages.length === 0) return { ok: true, message: "no images changed" };

    const formData = new FormData();
    formData.append("username", username);
    changedImages.forEach(ci => {
      if (ci.field === "prof") formData.append("prof_main", ci.file);
      else formData.append(`gallery_${ci.index}`, ci.file);
    });

    document.getElementById('progressContainer').style.display = 'block';
    let uploadText = document.getElementById('progressText')
    uploadText.textContent = 'Uploading images...';

    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();

xhr.upload.onprogress = (e) => {
  if (e.lengthComputable) {
    const percent = Math.round((e.loaded / e.total) * 100);
    document.getElementById('progressFill').style.width = percent + '%';

    // Update text dynamically at different milestones
    if (percent < 30) uploadText.textContent = `Uploading... ${percent}%`;
    else if (percent < 60) uploadText.textContent = `Halfway there... ${percent}%`;
    else if (percent < 90) uploadText.textContent = `Almost done... ${percent}%`;
    else if (percent < 100) uploadText.textContent = `Finishing up... ${percent}%`;
    else uploadText.textContent = 'Processing...';
  }
};


      xhr.onload = () => {
        if (xhr.status === 200) {
          try {
            resolve(JSON.parse(xhr.responseText));
          } catch (err) {
            reject(err);
          }
        } else {
          reject(new Error(`Upload failed: ${xhr.status}`));
        }
      };

      xhr.onerror = () => reject(new Error("Network error"));

      xhr.open("POST", "/profile/update/pics");
      xhr.send(formData);
    });
  }

  // === TEXT UPDATE (fake progress) ===
  async function updateChangedText() {
    const changed = {};

    textFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.dataset.modified === "true") {
        let value = el.isContentEditable ? (el.innerText || "") : (el.value || "");
        changed[id] = value.trim();
      }
    });

    privacyFields.forEach(field => {
      const checkbox = document.getElementById(field + 'Public');
      if (checkbox.dataset.modified == "true") changed[field + 'Public'] = checkbox.checked;
    });

    if (Object.keys(changed).length === 0) return { ok: true, message: "no text changed" };

    changed.username = username;

    document.getElementById('progressContainer').style.display = 'block';
    document.getElementById('progressText').textContent = 'Saving changes...';
    let fakePercent = 0;
    const fakeInterval = setInterval(() => {
      fakePercent += Math.random() * 15;
      if (fakePercent > 90) fakePercent = 90;
      document.getElementById('progressFill').style.width = fakePercent + '%';
    }, 200);
    const res = await fetch("/profile/update/text", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(changed)
    });

    clearInterval(fakeInterval);
    document.getElementById('progressFill').style.width = '100%';
    document.getElementById('progressText').textContent = 'Complete!';

    return await res.json();
  }

  document.querySelector('form button[type="submit"]').addEventListener('click', async (e) => {
    e.preventDefault();

const errors = [];

    const igHandle = document.getElementById('instagramHandle')?.value?.trim() || '';
    if (igHandle) {
        if (!igHandle.startsWith('@')) {
            errors.push(`Instagram handle must start with @ (example: @${`<%user.username%>`})`);
        } else if (igHandle.length < 3 || igHandle.length > 35) {
            errors.push("Instagram handle should be 3–30 characters long");
        }
    }

    const igLink = document.getElementById('instagramLink')?.value?.trim() || '';
    if (igLink) {
        if (!igLink.startsWith('https://')) {
            errors.push("Instagram link must start with https:// to be clickable");
        } else if (!igLink.includes('instagram.com') && !igLink.includes('instagr.am')) {
            errors.push("Instagram link should contain instagram.com or instagr.am");
        }
    }
    const fbLink = document.getElementById('facebookLink')?.value?.trim() || '';
    if (fbLink) {
        if (!fbLink.startsWith('https://')) {
            errors.push("Facebook link must start with https:// to be clickable");
        } else if (!fbLink.includes('facebook.com') && !fbLink.includes('fb.com')) {
            errors.push("Facebook link should contain facebook.com or fb.com");
        }
    }

    const waNumber = document.getElementById('whatsappNumber')?.value?.trim() || '';
    if (waNumber) {
        const cleaned = waNumber.replace(/[\s\-\(\)\.]/g, '');
        if (!cleaned.startsWith('+254')) {
            errors.push("WhatsApp number must start with +254 for Kenyan numbers");
        } else {
            const afterPrefix = cleaned.substring(4);
            if (afterPrefix.length !== 9) {
                errors.push("Kenyan number must have exactly 9 digits after +254");
            } else if (!afterPrefix.startsWith('7') && !afterPrefix.startsWith('1')) {
                errors.push("Kenyan numbers start with 07 or 01 (after +254)");
            } else if (!/^\d{9}$/.test(afterPrefix)) {
                errors.push("Only digits allowed after +254");
            }
        }
    }

    if (errors.length > 0) {
        showToast(
            "Please fix these:\n\n• " + errors.join("\n• "),
            'error'
        );
        return;
    }

    document.getElementById('progressFill').style.width = '0%';
    document.getElementById('progressContainer').style.display = 'none';

    const promises = [];

    if (changedImages.length > 0) promises.push(uploadChangedImages());
    const anyTextModified = (textFields.some(id => {
      const el = document.getElementById(id);
      return el && el.dataset.modified === "true"
    }) || privacyFields.some((field)=>{
      const element = document.getElementById(field + "Public");
      return element && element.dataset.modified == "true";
    }))
    if (anyTextModified) promises.push(updateChangedText());

    if (promises.length === 0) {
      showToast("Make at least one change to update.","error");
      return;
    }

    try {
      const results = await Promise.all(promises);

setTimeout(() => {
  document.getElementById('progressContainer').style.display = 'none';
  
  let updateType = "";
  if (changedImages.length > 0 && anyTextModified) {
    updateType = "whole vibe & pics";
  } else if (changedImages.length > 0) {
    updateType = "fire new pics";
  } else if (anyTextModified) {
    updateType = "whole vibe";
  } else {
    updateType = "profile";
  }
  
  showToast(`✨ Boom! Your ${updateType} just leveled up, "<%=user.username%>"! 🔥`,"green");
  
  changedImages.length = 0;
  textFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.dataset.modified = "false";
      el.classList.remove('edited');
    }
  });

  setTimeout(() => {
    localStorage.setItem("editAuthBeacon", Math.random() * 1000000000);
    window.location.href = "userProfile";
  }, 200);

}, 600);

    } catch (err) {
  document.getElementById('progressContainer').style.display = 'none';
  showToast("Oops! Something went wrong: " + err.message, 'error',"error");
}
  });
function showToast(message, type = 'success') {
  let toast = document.getElementById('toast');
  
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'toast';
    document.body.appendChild(toast);
  }

  toast.textContent = message;
  toast.className = 'toast ' + type;  // success or error
  toast.classList.add('show');

  setTimeout(() => {
    toast.classList.remove('show');
  }, 200);
}
  </script>

