<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        *{
            font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        }
        .body {
            background-color: red;        }
        .body2{
            background-color: green;
        }
        .body-message {
            background: radial-gradient(rgba(0, 0, 0, 0.63), rgb(71, 1, 1));
            width: 100%;
            color: white;
            font-size: 1.5rem;
            padding: 10px;
            text-align: left;
            padding-left: 5px;
            border: solid 2px rgb(255, 255, 255);
            box-shadow: inset 0px 0px 5px white;
            justify-self: center;
        }
        .error-title {
            color: white;
            font-weight: bold;
            background-color: rgba(61, 56, 56, 0.264);
            height: max-content;
            padding: 10px;
        }
        .blockquote {
            color: rgb(47, 19, 19);
        }
        .span {
            color: rgb(0, 128, 255);
        }
        h1 .a{
            font-size: 5rem;
        }
        #Box {
            background-color: green;
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            color: white;
            place-content: space-evenly;
        }
        .ab{
            background-color: rgb(0, 0, 0);
            width: 40px;
            justify-content: center;
            text-align: center;
        }
    </style>
</head>
<body class="body">
    <h2 class="error-title"> <span id="textCode"><%=body.errorCode %>! Unauthorized</span></h2>
    <h3 class="body-message body-message2"></h3>
    <h2 class="blockquote">we are redirecting you to <span class="span"> <%=body.redirecting %></span> </h2>
    
    <div id="Box">
        <h1 id="Timer" class="a ab">5</h1>
    <h1 id="Timer" class="b ab">4</h1>
    <h1 id="Timer" class="c ab">3</h1>
    <h1 id="Timer" class="d ab">2</h1>
    <h1 id="Timer" class="e ab">1</h1>
    </div>
    <script>
        let takeBack = `<%=body.takeBack%>`;
        localStorage.setItem('AuthWalkRoad',JSON.stringify(takeBack));
        let errorCode = `<%=body.errorCode%>`;
        let number = 2000; 
        let bodyMessage = document.querySelector(".body-message")
        let textCode = document.getElementById("textCode");
        let body = document.querySelector("body");
        localStorage.setItem("editAuthBeacon", Math.random() * 1000000000);
        if(errorCode > 201){
            number = 5000;
            textCode.innerHTML = `<%=body.errorCode %>! Unauthorized`;
            bodyMessage.innerHTML = `<%=body.message %>`;
        } else {
            textCode.innerHTML = `<%=body.errorCOde %>! Authorized`;
            body.classList.add("body2");
            bodyMessage.innerHTML = `<%=body.message %>`;
            localStorage.removeItem("AuthWalkRoad");
        }
        setTimeout(() => {
            // window.location.href = (`/<%= body.redirecting %>`)
           let location = `<%=body.redirecting%>`;
            window.location.href =  new URL(`https://mmun.rickdeazer.com/${location}`)
        }, number);
            let arrLoop = ["a","b","c","d","e"]
            stage = 0

            function hider(){
                element = document.querySelector(`.${arrLoop[stage]}`);
                element.style.color = "black";
            stage ++
            }
            let int = setInterval(() => {
                hider()
            }, 1000);
            setTimeout(() => {
                clearInterval(int);
            }, 4500);
    </script>
</body>
</html>