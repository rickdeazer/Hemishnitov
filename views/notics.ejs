    <script src="/dist/androidNotification.js"></script>
    <script src="/dist/androidHeader.js"></script>
    <script>
    function showTab(containerId) {
      
      document.querySelectorAll('.CONTAINER').forEach(el => el.classList.remove('active'));

      document.getElementById(containerId).classList.add('active');

      document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('tab-active'));
      if (containerId === 'Arenas-BODY') document.getElementById('Parties').classList.add('tab-active');
      if (containerId === 'Announcements') document.getElementById('sentBtn').classList.add('tab-active');
      if (containerId === 'Notics-BODY') document.getElementById('receivedBtn').classList.add('tab-active');
    }

    showTab('Arenas-BODY');
    function sendfeedback(vote,page) {
        fetch('/feedback/page/vote', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ voteData: {vote: vote, page: page} })
        });}
  </script>

</body>
